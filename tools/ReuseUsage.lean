  let belongs (n : Name) : Bool :=
    n == `solution || ["BorceaVariance.", "QuadraticTangZhang.", "Sendov.",
     "_private.BorceaVariance.", "_private.QuadraticTangZhang.", "_private.Sendov."].any
       (fun pref => n.toString.startsWith pref)
  let mut pending := starts
  let mut seen : NameSet := {}
  while !pending.isEmpty do
    let n := pending.back!
    pending := pending.pop
    if !seen.contains n && belongs n then
      seen := seen.insert n
      if let some info := env.find? n then
        pending := pending ++ info.getUsedConstantsAsSet.toArray
  let mut entries : Array Json := #[]
  for n in audited do
    let info ← getConstInfo n
    let fmt ← liftTermElabM <| Meta.ppExpr info.type
    let axioms ← collectAxioms n
    entries := entries.push <| Json.mkObj [
      ("name", toJson n.toString),
      ("used_by_verified_project_declaration", toJson (seen.contains n)),
      ("type", toJson fmt.pretty),
      ("axioms", toJson (axioms.map Name.toString))]
  liftIO <| IO.println (Json.arr entries).compress

