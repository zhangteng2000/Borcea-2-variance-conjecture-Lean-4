  (hB : ‖1 - ↑a * μ‖ ^ 2 ≤ s) : s < 1 / 9 ∧ a ^ 2 * s < 8 / 3
BorceaVariance.norm_product_bound_of_secondMoment {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {b : ℝ} (hb : 0 ≤ b)
  (hs : BorceaVariance.secondMoment q ≤ b ^ 2) : ∏ j, ‖q j‖ ≤ b ^ m
BorceaVariance.direct_linear_integral_bound {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) {a b : ℝ} (hb : 0 < b) (hb1 : b ≤ 1)
  (hκ : BorceaVariance.factorMean q a 1 ≤ 1 - b) :
  a ^ 2 * ∫ (t : ℝ) in 0..1, t * BorceaVariance.directMajorant q a t ≤
    a ^ 2 * BorceaVariance.secondMoment q * BorceaVariance.omissionConstant m 1 ^ 2 / (b ^ 2 * (↑m + 1))
BorceaVariance.normalized_compact {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n) :
