    Cbound + d ^ n +
      Cex.distinguished * ‖BorceaVariance.mean q‖ *
        ∑ k ∈ Finset.Ico 2 n,
          (Cex.distinguished ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑n - 2)) ^ (↑k / 2) *
            BorceaVariance.integralPowerSum k (n - 1 - k) d
BorceaVariance.bhatia_davis.{u_1} {ι : Type u_1} (s : Finset ι) (w x : ι → ℝ) {L U b : ℝ} (hw : ∀ i ∈ s, 0 ≤ w i)
  (hx : ∀ i ∈ s, L ≤ x i ∧ x i ≤ U) (hs : ∑ i ∈ s, w i = 1) (hb : ∑ i ∈ s, w i * x i = b) :
  ∑ i ∈ s, w i * (x i - b) ^ 2 ≤ (U - b) * (b - L)
BorceaVariance.rotated_real_variance_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (hμ : BorceaVariance.mean q ≠ 0)
  {t₀ : ℝ} (hunit : ∀ (j : Fin m), ‖q j‖ ≤ 1) (ht : ∀ (j : Fin m), t₀ ≤ ‖q j‖ ^ 2) :
  (∀ (j : Fin m),
      BorceaVariance.realCoordinateLower m ‖BorceaVariance.mean q‖ t₀ ≤ (BorceaVariance.rotateToMean q j).re) ∧
    BorceaVariance.realCoordinateVariance (BorceaVariance.rotateToMean q) ‖BorceaVariance.mean q‖ ≤
      min ((↑m - 1) * (1 - ‖BorceaVariance.mean q‖) ^ 2)
        ((1 - ‖BorceaVariance.mean q‖) *
          (‖BorceaVariance.mean q‖ - BorceaVariance.realCoordinateLower m ‖BorceaVariance.mean q‖ t₀))
BorceaVariance.normalized_signed_coefficient_test {n : ℕ} (hn : 4 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {d ε Kmin L Cbound : ℝ}
  (hh : 0 < Cex.distinguished * ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖)
  (hh1 : Cex.distinguished * ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤ 1)
  (hd : ‖1 - ↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤ d)
  (hε : ‖BorceaVariance.meanPhase (BorceaVariance.reciprocalFamily Cex.distinguished ζ) - 1‖ ≤ ε)
  (hK :
    Kmin ≤
      BorceaVariance.realQuadraticKernel (n - 1)
        (Cex.distinguished * ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖))
  (hK0 : 0 ≤ Kmin)
  (hL :
    L ≤
      (BorceaVariance.elementarySymmetric
          (fun j =>
            BorceaVariance.rotateToMean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) j -
              ↑‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖)
          2).re)
  (hL0 : 0 < L)
  (hC :
    ‖↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤
      Cbound) :
  have q := BorceaVariance.reciprocalFamily Cex.distinguished ζ;
  1 ≤
    Cbound + d ^ n - Cex.distinguished ^ 2 * Kmin * L +
        (↑n - 1) * Cex.distinguished ^ 2 * BorceaVariance.centeredVariance q / 2 *
          BorceaVariance.phaseError (n - 1) (Cex.distinguished * ‖BorceaVariance.mean q‖) d ε +
      Cex.distinguished * ‖BorceaVariance.mean q‖ *
        ∑ k ∈ Finset.Ico 3 n,
          (Cex.distinguished ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑n - 2)) ^ (↑k / 2) *
            BorceaVariance.integralPowerSum k (n - 1 - k) d
BorceaVariance.mean_phase_integral_bound {m : ℕ} (q : Fin m → ℂ) (hμ : BorceaVariance.mean q ≠ 0) {a d ε : ℝ}
  (ha : 0 ≤ a) (hh1 : a * ‖BorceaVariance.mean q‖ ≤ 1) (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d)
  (hε : ‖BorceaVariance.meanPhase q - 1‖ ≤ ε) :
  ‖BorceaVariance.meanPhase q ^ 2 * BorceaVariance.quadraticKernel m (↑a * BorceaVariance.mean q) -
        ↑(BorceaVariance.realQuadraticKernel m (a * ‖BorceaVariance.mean q‖))‖ ≤
    BorceaVariance.phaseError m (a * ‖BorceaVariance.mean q‖) d ε
BorceaVariance.no_normalized_counterexample_near_uniform {n : ℕ} (hn : 4 ≤ n) (hn13 : n ≤ 13)
  (Cex : BorceaVariance.NormalizedCounterexample n) (ζ : Fin (n - 1) → ℂ)
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots)
