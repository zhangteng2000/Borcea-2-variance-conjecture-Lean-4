  (ha : Polynomial.eval a p = 0) :
  ∃ z, Polynomial.eval z (Polynomial.derivative p) = 0 ∧ ‖a - z‖ ≤ BorceaVariance.sigma2 p
BorceaVariance.normalized_origin_identity_fin {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  ↑n *
      ∫ (t : ℝ) in 0..1,
        BorceaVariance.originProduct (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished t =
    (-1) ^ (n - 1) * BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)
BorceaVariance.normalized_center_identity_fin {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  have a := Cex.distinguished;
  have q := BorceaVariance.reciprocalFamily a ζ;
  have μ := BorceaVariance.mean q;
  have J := BorceaVariance.jointProduct z q;
  (-1) ^ (n - 1) * ↑a * μ * J + (1 - ↑a * μ) ^ n -
      ↑n * ↑a * μ * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t - (1 - ↑a * μ * ↑t) ^ (n - 1) =
    1
