  (P : BorceaVariance.Certificate.CounterexampleParameters n) :
  BorceaVariance.secondMoment P.critical ≤ 1 - 1 / (↑n - 1)
BorceaVariance.Certificate.CounterexampleParameters.moments {n : ℕ} (hn : 2 ≤ n)
  (P : BorceaVariance.Certificate.CounterexampleParameters n) :
  have a := P.configuration.distinguished;
  have μ := BorceaVariance.mean P.q;
  have s := BorceaVariance.secondMoment P.q;
  have v := BorceaVariance.centeredVariance P.q;
  have V := 1 - 1 / (↑n - 1);
  ‖μ‖ ^ 2 + (1 - V) * (1 - s) ≤ 2 * a * μ.re - a ^ 2 * s ∧
    ‖μ - ↑a‖ ^ 2 ≤ (a ^ 2 + V - 1) * (1 - s) ∧
      ‖1 - ↑a * μ‖ ^ 2 ≤ V * v ∧ 1 ≤ s * (a ^ 2 + V) ∧ BorceaVariance.beta a μ s 1 ≤ (a ^ 2 + V) * v
