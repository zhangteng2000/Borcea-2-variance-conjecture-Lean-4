  (hmono : MonotoneOn f (Set.Icc 0 ell)) (s : Multiset ℝ) (hs : ∀ x ∈ s, x ∈ Set.Icc 0 ell) (k : ℕ)
  (hr : r ∈ Set.Icc 0 ell) (hsum : s.sum ≤ ↑k * ell + r) :
  (Multiset.map f s).sum ≤ ↑k * f ell + f r + (↑s.card - ↑k - 1) * f 0
