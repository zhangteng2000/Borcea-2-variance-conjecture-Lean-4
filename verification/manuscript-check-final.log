BorceaVariance.elementarySymmetric_zero {m : ℕ} (w : Fin m → ℂ) : BorceaVariance.elementarySymmetric w 0 = 1
BorceaVariance.elementarySymmetric_one {m : ℕ} (w : Fin m → ℂ) : BorceaVariance.elementarySymmetric w 1 = ∑ j, w j
BorceaVariance.elementarySymmetric_mul {m : ℕ} (w : Fin m → ℂ) (c : ℂ) (k : ℕ) :
  BorceaVariance.elementarySymmetric (fun j => c * w j) k = c ^ k * BorceaVariance.elementarySymmetric w k
BorceaVariance.finite_product_expansion {m : ℕ} (w : Fin m → ℂ) (D c : ℂ) :
  ∏ j, (D + c * w j) = ∑ k ∈ Finset.range (m + 1), c ^ k * BorceaVariance.elementarySymmetric w k * D ^ (m - k)
BorceaVariance.centered_product_expansion {m : ℕ} (hm : 0 < m) (w : Fin m → ℂ) (hcenter : ∑ j, w j = 0) (D c : ℂ) :
  ∏ j, (D + c * w j) = D ^ m + ∑ k ∈ Finset.Ico 2 (m + 1), c ^ k * BorceaVariance.elementarySymmetric w k * D ^ (m - k)
BorceaVariance.origin_centered_product_expansion {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a t : ℝ) :
  BorceaVariance.centeredError q a t =
    ∑ k ∈ Finset.Ico 2 (m + 1),
      (-↑a * ↑t) ^ k * BorceaVariance.elementarySymmetric (fun j => q j - BorceaVariance.mean q) k *
