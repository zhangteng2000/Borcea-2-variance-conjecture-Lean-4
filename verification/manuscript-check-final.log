BorceaVariance.root_product_upper {m : ℕ} (hm : 0 < m) {a : ℝ} (ha : 0 ≤ a) (z : Fin m → ℂ)
  (henergy : a ^ 2 + ∑ j, ‖z j‖ ^ 2 = ↑m + 1) : a * ‖∏ j, z j‖ ≤ BorceaVariance.Phi m a
