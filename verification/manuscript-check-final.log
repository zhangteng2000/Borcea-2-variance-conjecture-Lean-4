        (∀ (j : Fin (n - 1)), Polynomial.eval (ζ j) (Polynomial.derivative Cex.polynomial) = 0) ∧
          ∀ (j : Fin (n - 1)), 1 < ‖↑Cex.distinguished - ζ j‖
BorceaVariance.sigma2_nonneg (p : Polynomial ℂ) : 0 ≤ BorceaVariance.sigma2 p
BorceaVariance.variance_nonneg (p : Polynomial ℂ) : 0 ≤ BorceaVariance.variance p
BorceaVariance.sigma2_sq (p : Polynomial ℂ) : BorceaVariance.sigma2 p ^ 2 = BorceaVariance.variance p
BorceaVariance.root_eq_centroid_of_variance_zero (p : Polynomial ℂ) (hn : 0 < p.natDegree)
  (hv : BorceaVariance.variance p = 0) {a : ℂ} (ha : a ∈ p.roots) : a = BorceaVariance.centroid p
BorceaVariance.polynomial_of_variance_zero (p : Polynomial ℂ) (hn : 0 < p.natDegree)
  (hv : BorceaVariance.variance p = 0) :
  p = Polynomial.C p.leadingCoeff * (Polynomial.X - Polynomial.C (BorceaVariance.centroid p)) ^ p.natDegree
BorceaVariance.zero_variance_main (p : Polynomial ℂ) (hn : 2 ≤ p.natDegree) (hv : BorceaVariance.variance p = 0) (a : ℂ)
  (ha : Polynomial.eval a p = 0) :
  ∃ z, Polynomial.eval z (Polynomial.derivative p) = 0 ∧ ‖a - z‖ ≤ BorceaVariance.sigma2 p
BorceaVariance.sigma2_pos_of_counterexample (p : Polynomial ℂ) (hn : 2 ≤ p.natDegree) (a : ℂ)
  (ha : Polynomial.eval a p = 0)
  (hfar : ∀ (z : ℂ), Polynomial.eval z (Polynomial.derivative p) = 0 → BorceaVariance.sigma2 p < ‖a - z‖) :
  0 < BorceaVariance.sigma2 p
BorceaVariance.exponential_series_bounds {x : ℝ} (hx : 0 ≤ x) (k : ℕ) (hk : x < ↑k + 2) :
  ∑ j ∈ Finset.range (k + 1), x ^ j / ↑j.factorial ≤ Real.exp x ∧
    Real.exp x ≤
      ∑ j ∈ Finset.range (k + 1), x ^ j / ↑j.factorial + x ^ (k + 1) / ↑(k + 1).factorial * (1 - x / (↑k + 2))⁻¹
BorceaVariance.normalized_other_roots {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n) :
  ∃ z,
    Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)) ∧
      ↑Cex.distinguished + ∑ j, z j = 0 ∧ Cex.distinguished ^ 2 + ∑ j, ‖z j‖ ^ 2 = ↑n
