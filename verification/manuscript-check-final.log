BorceaVariance.centered_variance_sum {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) :
  ∑ i, ‖q i - BorceaVariance.mean q‖ ^ 2 = ↑m * BorceaVariance.centeredVariance q
BorceaVariance.centeredVariance_nonneg {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) : 0 ≤ BorceaVariance.centeredVariance q
BorceaVariance.weighted_complex_cauchy.{u_1} {ι : Type u_1} (s : Finset ι) (w : ι → ℝ) (f g : ι → ℂ)
  (hw : ∀ i ∈ s, 0 ≤ w i) : ‖∑ i ∈ s, ↑(w i) * f i * g i‖ ^ 2 ≤ (∑ i ∈ s, w i * ‖f i‖ ^ 2) * ∑ i ∈ s, w i * ‖g i‖ ^ 2
BorceaVariance.complex_cauchy.{u_1} {ι : Type u_1} (s : Finset ι) (f g : ι → ℂ) :
  ‖∑ i ∈ s, f i * g i‖ ^ 2 ≤ (∑ i ∈ s, ‖f i‖ ^ 2) * ∑ i ∈ s, ‖g i‖ ^ 2
BorceaVariance.origin_identity_multiset {n : ℕ} {a c : ℂ} {z q : Multiset ℂ} {p : Polynomial ℂ} (hc : c ≠ 0)
  (hzcard : z.card = n - 1) (hq : ∀ v ∈ q, v ≠ 0) (hpa : Polynomial.eval a p = 0)
  (hpz :
    p =
      Polynomial.C c *
        ((Polynomial.X - Polynomial.C a) * (Multiset.map (fun w => Polynomial.X - Polynomial.C w) z).prod))
  (hpq :
    Polynomial.derivative p =
      Polynomial.C (↑n * c) *
        (Multiset.map (fun w => Polynomial.X - Polynomial.C w) (Multiset.map (fun v => a - v⁻¹) q)).prod) :
  ↑n * ∫ (t : ℝ) in 0..1, (Multiset.map (fun v => 1 - a * ↑t * v) q).prod = (-1) ^ (n - 1) * q.prod * z.prod
BorceaVariance.normalized_origin_identity {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n) (s : Multiset ℂ)
  (hcard : s.card = n - 1)
  (hp :
    Cex.polynomial =
      (Polynomial.X - Polynomial.C ↑Cex.distinguished) *
        (Multiset.map (fun z => Polynomial.X - Polynomial.C z) s).prod) :
  have q := QuadraticTangZhang.criticalReciprocals Cex.polynomial ↑Cex.distinguished;
  ↑n * ∫ (t : ℝ) in 0..1, (Multiset.map (fun v => 1 - ↑Cex.distinguished * ↑t * v) q).prod =
    (-1) ^ (n - 1) * q.prod * s.prod
BorceaVariance.differential_identity {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a : ℝ) :
  (BorceaVariance.originProduct q a 1 +
        ↑m * ↑a * BorceaVariance.mean q * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t) +
      BorceaVariance.originRemainder q a =
    1
BorceaVariance.center_power_integral (m : ℕ) (b : ℂ) :
  b * ↑(m + 1) * ∫ (t : ℝ) in 0..1, (1 - b * ↑t) ^ m = 1 - (1 - b) ^ (m + 1)
BorceaVariance.center_identity {m : ℕ} (q : Fin m → ℂ) (a : ℝ) (J : ℂ)
  (horigin : ↑(m + 1) * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t = (-1) ^ m * J) :
  (-1) ^ m * ↑a * BorceaVariance.mean q * J + (1 - ↑a * BorceaVariance.mean q) ^ (m + 1) -
      ↑(m + 1) * ↑a * BorceaVariance.mean q *
        ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t - (1 - ↑a * BorceaVariance.mean q * ↑t) ^ m =
    1
BorceaVariance.centered_error_integral_bound {m : ℕ} (q : Fin m → ℂ) (a : ℝ) (U : ℝ → ℝ)
  (hi : IntervalIntegrable (fun t => t ^ 2 * U t) MeasureTheory.volume 0 1)
  (hU :
    ∀ t ∈ Set.Icc 0 1, ‖BorceaVariance.centeredError q a t‖ ≤ a ^ 2 * t ^ 2 * BorceaVariance.centeredVariance q * U t) :
  ‖∫ (t : ℝ) in 0..1, BorceaVariance.centeredError q a t‖ ≤
    a ^ 2 * BorceaVariance.centeredVariance q * ∫ (t : ℝ) in 0..1, t ^ 2 * U t
BorceaVariance.absolute_integral_test {m : ℕ} (q : Fin m → ℂ) {a : ℝ} (ha : 0 ≤ a) (J : ℂ)
  (horigin : ↑(m + 1) * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t = (-1) ^ m * J) {C V : ℝ}
  (hC : ‖↑a * BorceaVariance.mean q * J‖ ≤ C)
  (hB : ‖1 - ↑a * BorceaVariance.mean q‖ ^ 2 ≤ V * BorceaVariance.centeredVariance q) (U : ℝ → ℝ)
  (hi : IntervalIntegrable (fun t => t ^ 2 * U t) MeasureTheory.volume 0 1)
  (hU :
    ∀ t ∈ Set.Icc 0 1, ‖BorceaVariance.centeredError q a t‖ ≤ a ^ 2 * t ^ 2 * BorceaVariance.centeredVariance q * U t) :
  1 ≤
    C + (V * BorceaVariance.centeredVariance q) ^ (↑(m + 1) / 2) +
      BorceaVariance.centerIntegralCoefficient m a ‖BorceaVariance.mean q‖ U * BorceaVariance.centeredVariance q
BorceaVariance.beta_nat_succ_identity (k p : ℕ) :
  (↑k + 1) * ∫ (t : ℝ) in 0..1, t ^ k * (1 - t) ^ (p + 1) = (↑p + 1) * ∫ (t : ℝ) in 0..1, t ^ (k + 1) * (1 - t) ^ p
BorceaVariance.integral_nat_beta (k p : ℕ) :
  ∫ (t : ℝ) in 0..1, t ^ k * (1 - t) ^ p = ↑k.factorial * ↑p.factorial / ↑(k + p + 1).factorial
BorceaVariance.rpow_le_max_endpoint {x p pLower pUpper : ℝ} (hx : 0 ≤ x) (hp0 : 0 ≤ pLower) (hpLower : pLower ≤ p)
  (hpUpper : p ≤ pUpper) : x ^ p ≤ max (x ^ pLower) (x ^ pUpper)
BorceaVariance.retained_base_antitone_degree {M N B δ : ℝ} (hM : 1 < M) (hMN : M ≤ N) (hδ : δ ≤ B) :
  (N * B - δ) / (N - 1) ≤ (M * B - δ) / (M - 1)
BorceaVariance.retained_block_power_bound {M N m B δ : ℝ} (hM : 1 < M) (hMm : M ≤ m) (hmN : m ≤ N) (hδ : δ ≤ B) :
  max 0 ((m * B - δ) / (m - 1)) ^ ((m - 1) / 2) ≤
    max (max 0 ((M * B - δ) / (M - 1)) ^ ((M - 1) / 2)) (max 0 ((M * B - δ) / (M - 1)) ^ ((N - 1) / 2))
BorceaVariance.retained_block_nat_power_bound {M N m : ℕ} {B δ : ℝ} (hM : 2 ≤ M) (hMm : M ≤ m) (hmN : m ≤ N)
  (hδ : δ ≤ B) :
  max 0 ((↑m * B - δ) / ↑(m - 1)) ^ (m - 1) ≤
    max (max 0 ((↑M * B - δ) / ↑(M - 1)) ^ (M - 1)) (max 0 ((↑M * B - δ) / ↑(M - 1)) ^ (N - 1))
BorceaVariance.centered_first_remainder_general {m : ℕ} (w : Fin m → ℂ) (hw : ∑ j, w j = 0) {D : ℂ} (hD : D ≠ 0) (c : ℝ)
  {U : ℝ} (hU : 0 ≤ U) (hdel : ∀ θ ∈ Set.Icc 0 1, ∀ (j : Fin m), ‖∏ k ∈ Finset.univ.erase j, (D - ↑c * ↑θ * w k)‖ ≤ U) :
  ‖∏ j, (D - ↑c * w j) - D ^ m‖ ≤ (c ^ 2 * ∑ j, ‖w j‖ ^ 2) / (2 * ‖D‖) * U
BorceaVariance.centered_first_remainder_moments {m : ℕ} (hm : 2 ≤ m) (w : Fin m → ℂ) (hw : ∑ j, w j = 0) {D : ℂ}
  (hD : D ≠ 0) (c : ℝ) {B L : ℝ} (hB : 0 ≤ B) (hL : 0 ≤ L) (hsecond : ∑ j, ‖D - ↑c * w j‖ ^ 2 ≤ ↑m * B)
  (hfirst : ∑ j, ‖D - ↑c * w j‖ ≤ ↑m * L) :
  ‖∏ j, (D - ↑c * w j) - D ^ m‖ ≤
    (c ^ 2 * ∑ j, ‖w j‖ ^ 2) / (2 * ‖D‖) *
      min (BorceaVariance.omissionConstant m 1 * B ^ (↑(m - 1) / 2))
        (BorceaVariance.omissionConstant m 1 ^ 2 * L ^ (m - 1))
BorceaVariance.centered_interpolation_first {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) {a t B L : ℝ}
  (hD : 1 - ↑a * ↑t * BorceaVariance.mean q ≠ 0)
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  ‖BorceaVariance.originProduct q a t - (1 - ↑a * ↑t * BorceaVariance.mean q) ^ m‖ ≤
    ↑m * a ^ 2 * t ^ 2 * BorceaVariance.centeredVariance q / (2 * ‖1 - ↑a * ↑t * BorceaVariance.mean q‖) *
      min (BorceaVariance.omissionConstant m 1 * B ^ (↑(m - 1) / 2))
        (BorceaVariance.omissionConstant m 1 ^ 2 * L ^ (m - 1))
BorceaVariance.centered_second_remainder_general {m : ℕ} (hm : 0 < m) (w : Fin m → ℂ) (hw : ∑ j, w j = 0) (D : ℂ)
  (c : ℝ) {U : ℝ} (hU : 0 ≤ U)
  (hdel : ∀ θ ∈ Set.Icc 0 1, ∀ (j k : Fin m), k ≠ j → ‖∏ r ∈ (Finset.univ.erase j).erase k, (D - ↑c * ↑θ * w r)‖ ≤ U) :
  ‖∏ j, (D - ↑c * w j) - D ^ m‖ ≤ (↑(m - 1) * c ^ 2 * ∑ j, ‖w j‖ ^ 2) / 2 * U
BorceaVariance.centered_second_remainder_moments {m : ℕ} (hm : 3 ≤ m) (w : Fin m → ℂ) (hw : ∑ j, w j = 0) (D : ℂ)
  (c : ℝ) {B L : ℝ} (hB : 0 ≤ B) (hL : 0 ≤ L) (hsecond : ∑ j, ‖D - ↑c * w j‖ ^ 2 ≤ ↑m * B)
  (hfirst : ∑ j, ‖D - ↑c * w j‖ ≤ ↑m * L) :
  ‖∏ j, (D - ↑c * w j) - D ^ m‖ ≤
    (↑(m - 1) * c ^ 2 * ∑ j, ‖w j‖ ^ 2) / 2 *
      min (BorceaVariance.omissionConstant m 2 * B ^ (↑(m - 2) / 2))
        (BorceaVariance.omissionConstant m 2 ^ 2 * L ^ (m - 2))
BorceaVariance.centered_interpolation_second {m : ℕ} (hm : 3 ≤ m) (q : Fin m → ℂ) {a t B L : ℝ}
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  ‖BorceaVariance.originProduct q a t - (1 - ↑a * ↑t * BorceaVariance.mean q) ^ m‖ ≤
    ↑m * ↑(m - 1) * a ^ 2 * t ^ 2 * BorceaVariance.centeredVariance q / 2 *
      min (BorceaVariance.omissionConstant m 2 * B ^ (↑(m - 2) / 2))
        (BorceaVariance.omissionConstant m 2 ^ 2 * L ^ (m - 2))
BorceaVariance.omissionConstant_sq_le_exp {m k : ℕ} (hk : k < m) : BorceaVariance.omissionConstant m k ^ 2 ≤ Real.exp ↑k
BorceaVariance.omission_one_constant_bounds {m : ℕ} (hm : 2 ≤ m) :
  BorceaVariance.omissionConstant m 1 < 5 / 3 ∧ BorceaVariance.omissionConstant m 1 ^ 2 < 3
BorceaVariance.omission_two_constant_bounds {m : ℕ} (hm : 3 ≤ m) :
  BorceaVariance.omissionConstant m 2 < 3 ∧ BorceaVariance.omissionConstant m 2 ^ 2 < 9
BorceaVariance.convex_quadratic_majorant {S : Set ℝ} (hS : Convex ℝ S) (H : ℝ) {A : ℝ} (hA : 0 ≤ A) :
  ConvexOn ℝ S fun t => 1 - H * t - A * t * (1 - t)
BorceaVariance.convex_linear_majorant {S : Set ℝ} (hS : Convex ℝ S) (κ : ℝ) : ConvexOn ℝ S fun t => 1 - (1 - κ) * t
BorceaVariance.convex_nonnegative_rpow {S : Set ℝ} {f : ℝ → ℝ} (hf : ConvexOn ℝ S f) (hf0 : ∀ t ∈ S, 0 ≤ f t) {r : ℝ}
  (hr : 1 ≤ r) : ConvexOn ℝ S fun t => f t ^ r
BorceaVariance.convex_positive_part {S : Set ℝ} {f : ℝ → ℝ} (hf : ConvexOn ℝ S f) : ConvexOn ℝ S fun t => max 0 (f t)
BorceaVariance.convex_retained_base {S : Set ℝ} {f : ℝ → ℝ} (hf : ConvexOn ℝ S f) {M : ℝ} (hM : 1 < M) (δ : ℝ) :
  ConvexOn ℝ S fun t => max 0 ((M * f t - δ) / (M - 1))
BorceaVariance.convex_retained_block_powers {S : Set ℝ} {f : ℝ → ℝ} (hf : ConvexOn ℝ S f) {M p q : ℝ} (hM : 1 < M)
  (hp : 1 ≤ p) (hq : 1 ≤ q) (δ : ℝ) :
  ConvexOn ℝ S fun t => max (max 0 ((M * f t - δ) / (M - 1)) ^ p) (max 0 ((M * f t - δ) / (M - 1)) ^ q)
BorceaVariance.chord_one {f : ℝ → ℝ} {l u : ℝ} (hl : 0 ≤ l) (hlu : l ≤ u) (hf : ConvexOn ℝ (Set.Icc l u) f)
  (hc : ContinuousOn f (Set.Icc l u)) :
  ∫ (t : ℝ) in l..u, t * f t ≤ (u - l) * (2 * l + u) / 6 * f l + (u - l) * (l + 2 * u) / 6 * f u
BorceaVariance.chord_two {f : ℝ → ℝ} {l u : ℝ} (hl : 0 ≤ l) (hlu : l ≤ u) (hf : ConvexOn ℝ (Set.Icc l u) f)
  (hc : ContinuousOn f (Set.Icc l u)) :
  ∫ (t : ℝ) in l..u, t ^ 2 * f t ≤
    (u - l) * (3 * l ^ 2 + 2 * l * u + u ^ 2) / 12 * f l + (u - l) * (l ^ 2 + 2 * l * u + 3 * u ^ 2) / 12 * f u
BorceaVariance.le_min_of_separate_bounds {I U V : ℝ} (hU : I ≤ U) (hV : I ≤ V) : I ≤ min U V
BorceaVariance.directMajorant_le_first_moment {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (hq : ∀ (j : Fin m), ‖q j‖ ≤ 1)
  (a t : ℝ) : BorceaVariance.directMajorant q a t ≤ ↑m * BorceaVariance.factorMean q a t ^ (m - 1)
BorceaVariance.direct_unit_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (hq : ∀ (j : Fin m), ‖q j‖ ≤ 1) {a t B L : ℝ}
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  BorceaVariance.directMajorant q a t ≤ ↑m * min (B ^ (↑(m - 1) / 2)) (L ^ (m - 1))
BorceaVariance.direct_second_moment_bound {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) {a t B L : ℝ}
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  BorceaVariance.directMajorant q a t ≤
    ↑m * BorceaVariance.secondMoment q *
      min (BorceaVariance.omissionConstant m 1 * B ^ (↑(m - 1) / 2))
        (BorceaVariance.omissionConstant m 1 ^ 2 * L ^ (m - 1))
BorceaVariance.direct_bound {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) (hq : ∀ (j : Fin m), ‖q j‖ ≤ 1) {a t B L : ℝ}
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  BorceaVariance.directMajorant q a t ≤
    ↑m *
      min (min 1 (BorceaVariance.omissionConstant m 1 * BorceaVariance.secondMoment q) * B ^ (↑(m - 1) / 2))
        (min 1 (BorceaVariance.omissionConstant m 1 ^ 2 * BorceaVariance.secondMoment q) * L ^ (m - 1))
BorceaVariance.weighted_deleted_product_bound {m : ℕ} (hm : 0 < m) (q f : Fin m → ℂ) {B : ℝ}
  (hB : ∀ (j : Fin m), ‖∏ k ∈ Finset.univ.erase j, f k‖ ≤ B) :
  ∑ j, ‖q j‖ ^ 2 * ∏ k ∈ Finset.univ.erase j, ‖f k‖ ≤ ↑m * BorceaVariance.secondMoment q * B
BorceaVariance.retained_factor_lower {m : ℕ} (q : Fin m → ℂ) (hq : ∀ (j : Fin m), ‖q j‖ ≤ 1) {a aUpper t u : ℝ}
  (ha : 0 ≤ a) (haUpper : a ≤ aUpper) (ht : 0 ≤ t) (htu : t ≤ u) (j : Fin m) :
  max 0 (1 - aUpper * u) ≤ ‖1 - ↑a * ↑t * q j‖
BorceaVariance.direct_retained_bound {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) (hq : ∀ (j : Fin m), ‖q j‖ ≤ 1)
  {a aUpper t u B L : ℝ} (ha : 0 ≤ a) (haUpper : a ≤ aUpper) (ht : 0 ≤ t) (htu : t ≤ u)
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  have δ := max 0 (1 - aUpper * u);
  BorceaVariance.directMajorant q a t ≤
    ↑m * BorceaVariance.secondMoment q *
      min (max 0 ((↑m * B - δ ^ 2) / ↑(m - 1)) ^ (↑(m - 1) / 2)) (max 0 ((↑m * L - δ) / ↑(m - 1)) ^ (m - 1))
BorceaVariance.originErrorSum_norm_le_directMajorant {m : ℕ} (q : Fin m → ℂ) (a t : ℝ) :
  ‖QuadraticTangZhang.originErrorSum q a t‖ ≤ BorceaVariance.directMajorant q a t
BorceaVariance.originProduct_endpoint_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a : ℝ) {κ : ℝ}
  (hκ : BorceaVariance.factorMean q a 1 ≤ κ) : ‖BorceaVariance.originProduct q a 1‖ ≤ κ ^ m
BorceaVariance.originRemainder_norm_le_direct_integral {m : ℕ} (q : Fin m → ℂ) (a : ℝ) :
  ‖BorceaVariance.originRemainder q a‖ ≤ a ^ 2 * ∫ (t : ℝ) in 0..1, t * BorceaVariance.directMajorant q a t
BorceaVariance.origin_core_integral_bound {m : ℕ} (q : Fin m → ℂ) (a : ℝ) (J : ℂ)
  (horigin : ↑(m + 1) * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t = (-1) ^ m * J) {C : ℝ}
  (hC : ‖↑a * BorceaVariance.mean q * J‖ ≤ C) :
  ‖↑m * ↑a * BorceaVariance.mean q * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t‖ ≤ ↑m / ↑(m + 1) * C
BorceaVariance.direct_integral_test {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a : ℝ) (J : ℂ)
  (horigin : ↑(m + 1) * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t = (-1) ^ m * J) {κ C : ℝ}
  (hκ : BorceaVariance.factorMean q a 1 ≤ κ) (hC : ‖↑a * BorceaVariance.mean q * J‖ ≤ C) :
  1 ≤ κ ^ m + ↑m / ↑(m + 1) * C + a ^ 2 * ∫ (t : ℝ) in 0..1, t * BorceaVariance.directMajorant q a t
BorceaVariance.binomial_beta_identity (k p j : ℕ) (hj : j ≤ p) :
  ↑(p.choose j) * ∫ (t : ℝ) in 0..1, t ^ (k + j) * (1 - t) ^ (p - j) =
    ↑((k + j).choose k) / (↑(k + p + 1) * ↑((k + p).choose k))
BorceaVariance.binomial_linear_factor_expansion (p : ℕ) (d t : ℝ) :
  (1 - t + d * t) ^ p = ∑ j ∈ Finset.range (p + 1), ↑(p.choose j) * d ^ j * t ^ j * (1 - t) ^ (p - j)
BorceaVariance.integral_polynomial_identity (k p : ℕ) (d : ℝ) :
  ∫ (t : ℝ) in 0..1, t ^ k * (1 - t + d * t) ^ p = BorceaVariance.integralPolynomial k p d
BorceaVariance.integralPolynomial_nonneg (k p : ℕ) {d : ℝ} (hd : 0 ≤ d) : 0 ≤ BorceaVariance.integralPolynomial k p d
BorceaVariance.power_sum_integral_relation {m k : ℕ} (hkm : k ≤ m) (d : ℝ) :
  (↑m + 1) * ↑(m.choose k) * BorceaVariance.integralPolynomial k (m - k) d = BorceaVariance.integralPowerSum k (m - k) d
BorceaVariance.interpolationPolynomial_derivative.{u_1} {ι : Type u_1} [DecidableEq ι] (S : Finset ι) (D c : ℂ)
  (w : ι → ℂ) :
  Polynomial.derivative (BorceaVariance.interpolationPolynomial S D c w) =
    -Polynomial.C c * ∑ j ∈ S, Polynomial.C (w j) * BorceaVariance.interpolationPolynomial (S.erase j) D c w
BorceaVariance.interpolationPolynomial_second_derivative.{u_1} {ι : Type u_1} [DecidableEq ι] (S : Finset ι) (D c : ℂ)
  (w : ι → ℂ) :
  Polynomial.derivative (Polynomial.derivative (BorceaVariance.interpolationPolynomial S D c w)) =
    Polynomial.C (c ^ 2) *
      ∑ j ∈ S,
        ∑ k ∈ S.erase j, Polynomial.C (w j * w k) * BorceaVariance.interpolationPolynomial ((S.erase j).erase k) D c w
BorceaVariance.interpolationPolynomial_derivative_zero {m : ℕ} (w : Fin m → ℂ) (hw : ∑ j, w j = 0) (D c : ℂ) :
  Polynomial.eval 0 (Polynomial.derivative (BorceaVariance.interpolationPolynomial Finset.univ D c w)) = 0
BorceaVariance.polynomial_taylor_second (P : Polynomial ℂ) :
  Polynomial.eval 1 P - Polynomial.eval 0 P - Polynomial.eval 0 (Polynomial.derivative P) =
    ∫ (θ : ℝ) in 0..1, (1 - ↑θ) * Polynomial.eval (↑θ) (Polynomial.derivative (Polynomial.derivative P))
BorceaVariance.ordered_pair_norm_sum_bound {m : ℕ} (hm : 0 < m) (w : Fin m → ℂ) :
  ∑ j, ∑ k ∈ Finset.univ.erase j, ‖w j‖ * ‖w k‖ ≤ ↑(m - 1) * ∑ j, ‖w j‖ ^ 2
BorceaVariance.centered_norm_le_factor_mean {m : ℕ} (hm : 0 < m) (w : Fin m → ℂ) (hw : ∑ j, w j = 0) (D : ℂ) (c : ℝ) :
  ↑m * ‖D‖ ≤ ∑ j, ‖D - ↑c * w j‖
BorceaVariance.centered_interpolation_second_moment {m : ℕ} (w : Fin m → ℂ) (hw : ∑ j, w j = 0) (D : ℂ) (c : ℝ)
  {B θ : ℝ} (hB : ∑ j, ‖D - ↑c * w j‖ ^ 2 ≤ ↑m * B) (hθ : 0 ≤ θ) (hθ1 : θ ≤ 1) : ∑ j, ‖D - ↑c * ↑θ * w j‖ ^ 2 ≤ ↑m * B
BorceaVariance.centered_interpolation_first_moment {m : ℕ} (hm : 0 < m) (w : Fin m → ℂ) (hw : ∑ j, w j = 0) (D : ℂ)
  (c : ℝ) {L θ : ℝ} (hL : ∑ j, ‖D - ↑c * w j‖ ≤ ↑m * L) (hθ : 0 ≤ θ) (hθ1 : θ ≤ 1) : ∑ j, ‖D - ↑c * ↑θ * w j‖ ≤ ↑m * L
BorceaVariance.integral_beta_one (p : ℕ) : ∫ (t : ℝ) in 0..1, t * (1 - t) ^ p = 1 / ((↑p + 1) * (↑p + 2))
BorceaVariance.integral_linear_power_upper (p : ℕ) {b : ℝ} (hb : 0 < b) (hb1 : b ≤ 1) :
  ∫ (t : ℝ) in 0..1, t * (1 - b * t) ^ p ≤ 1 / (b ^ 2 * (↑p + 1) * (↑p + 2))
BorceaVariance.esymm_fin_card_pred {m : ℕ} (hm : 0 < m) (f : Fin m → ℝ) :
  (Multiset.map f Finset.univ.val).esymm (m - 1) = ∑ j, ∏ k ∈ Finset.univ.erase j, f k
BorceaVariance.sum_deleted_prod_le_mean {m : ℕ} (hm : 0 < m) (f : Fin m → ℝ) (hf : ∀ (j : Fin m), 0 ≤ f j) :
  ∑ j, ∏ k ∈ Finset.univ.erase j, f k ≤ ↑m * ((∑ j, f j) / ↑m) ^ (m - 1)
BorceaVariance.factorMean_nonneg {m : ℕ} (q : Fin m → ℂ) (a t : ℝ) : 0 ≤ BorceaVariance.factorMean q a t
BorceaVariance.factorMean_sq_le_beta {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a t : ℝ) :
  BorceaVariance.factorMean q a t ^ 2 ≤ BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t
BorceaVariance.factorMean_endpoint_sq_le {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  BorceaVariance.factorMean (BorceaVariance.reciprocalFamily a ζ) a 1 ^ 2 ≤
    V * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)
BorceaVariance.factorMean_endpoint_le_kappa {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) {V κ : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) (hκ : 0 ≤ κ)
  (hκ2 :
    min
        (BorceaVariance.beta a (BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ))
          (BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) 1)
        (V * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) ≤
      κ ^ 2) :
  BorceaVariance.factorMean (BorceaVariance.reciprocalFamily a ζ) a 1 ≤ κ
BorceaVariance.factorMean_endpoint_sqrt_bound {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  BorceaVariance.factorMean (BorceaVariance.reciprocalFamily a ζ) a 1 ≤
    √(min
        (BorceaVariance.beta a (BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ))
          (BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) 1)
        (V * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)))
BorceaVariance.factorMean_linear_majorant {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a : ℝ) {κ t : ℝ}
  (hκ : BorceaVariance.factorMean q a 1 ≤ κ) (ht : 0 ≤ t) (ht1 : t ≤ 1) :
  BorceaVariance.factorMean q a t ≤ 1 - (1 - κ) * t
BorceaVariance.originProduct_norm_le_second_moment {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a t : ℝ) :
  ‖BorceaVariance.originProduct q a t‖ ≤
    BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ^ (↑m / 2)
BorceaVariance.omissionConstant_nonneg (m k : ℕ) : 0 ≤ BorceaVariance.omissionConstant m k
BorceaVariance.omissionConstant_sq (m k : ℕ) : BorceaVariance.omissionConstant m k ^ 2 = (↑m / ↑(m - k)) ^ (m - k)
BorceaVariance.pow_le_rpow_half_of_sq_le {x B : ℝ} (hx : 0 ≤ x) (h : x ^ 2 ≤ B) (k : ℕ) : x ^ k ≤ B ^ (↑k / 2)
BorceaVariance.norm_subproduct_le_second_moment {m k : ℕ} (hk : k < m) (f : Fin m → ℂ) (S : Finset (Fin m))
  (hcard : S.card = m - k) {B : ℝ} (hB : 0 ≤ B) (hmean : ∑ j, ‖f j‖ ^ 2 ≤ ↑m * B) :
  ‖∏ j ∈ S, f j‖ ≤ BorceaVariance.omissionConstant m k * B ^ (↑(m - k) / 2)
BorceaVariance.norm_subproduct_le_first_moment {m k : ℕ} (hk : k < m) (f : Fin m → ℂ) (S : Finset (Fin m))
  (hcard : S.card = m - k) {L : ℝ} (hL : 0 ≤ L) (hmean : ∑ j, ‖f j‖ ≤ ↑m * L) :
  ‖∏ j ∈ S, f j‖ ≤ BorceaVariance.omissionConstant m k ^ 2 * L ^ (m - k)
BorceaVariance.normalized_direct_integral_test {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {κ Cbound : ℝ}
  (hκ : BorceaVariance.factorMean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished 1 ≤ κ)
  (hC :
    ‖↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤
      Cbound) :
  1 ≤
    κ ^ (n - 1) + ↑(n - 1) / ↑n * Cbound +
      Cex.distinguished ^ 2 *
        ∫ (t : ℝ) in 0..1,
          t * BorceaVariance.directMajorant (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished t
BorceaVariance.normalized_absolute_integral_test {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {Cbound : ℝ}
  (hC :
    ‖↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤
      Cbound)
  (U : ℝ → ℝ) (hi : IntervalIntegrable (fun t => t ^ 2 * U t) MeasureTheory.volume 0 1)
  (hU :
    ∀ t ∈ Set.Icc 0 1,
      ‖BorceaVariance.centeredError (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished t‖ ≤
        Cex.distinguished ^ 2 * t ^ 2 *
            BorceaVariance.centeredVariance (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          U t) :
  have q := BorceaVariance.reciprocalFamily Cex.distinguished ζ;
  1 ≤
    Cbound + ((1 - 1 / (↑n - 1)) * BorceaVariance.centeredVariance q) ^ (↑n / 2) +
      BorceaVariance.centerIntegralCoefficient (n - 1) Cex.distinguished ‖BorceaVariance.mean q‖ U *
        BorceaVariance.centeredVariance q
BorceaVariance.normalized_ratio_integral_test {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (henergy : Cex.distinguished ^ 2 + ∑ j, ‖z j‖ ^ 2 = ↑n)
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) (U : ℝ → ℝ)
  (hi : IntervalIntegrable (fun t => t ^ 2 * U t) MeasureTheory.volume 0 1) (hU0 : ∀ t ∈ Set.Icc 0 1, 0 ≤ U t)
  (hU :
    ∀ t ∈ Set.Icc 0 1,
