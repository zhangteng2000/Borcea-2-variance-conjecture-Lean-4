BorceaVariance.finite_real_coordinate_lower {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {r t₀ : ℝ} (hr : 0 < r)
  (hsum : ∑ j, q j = ↑m * ↑r) (hunit : ∀ (j : Fin m), ‖q j‖ ≤ 1) (ht : ∀ (j : Fin m), t₀ ≤ ‖q j‖ ^ 2) (j : Fin m) :
  BorceaVariance.realCoordinateLower m r t₀ ≤ (q j).re
BorceaVariance.finite_real_variance_of_bounds {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {r L : ℝ} (hsum : ∑ j, q j = ↑m * ↑r)
  (hunit : ∀ (j : Fin m), ‖q j‖ ≤ 1) (hlower : ∀ (j : Fin m), L ≤ (q j).re) :
  BorceaVariance.realCoordinateVariance q r ≤ (1 - r) * (r - L)
BorceaVariance.finite_real_variance_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {r t₀ : ℝ} (hr : 0 < r)
  (hsum : ∑ j, q j = ↑m * ↑r) (hunit : ∀ (j : Fin m), ‖q j‖ ≤ 1) (ht : ∀ (j : Fin m), t₀ ≤ ‖q j‖ ^ 2) :
  BorceaVariance.realCoordinateVariance q r ≤
    min ((↑m - 1) * (1 - r) ^ 2) ((1 - r) * (r - BorceaVariance.realCoordinateLower m r t₀))
BorceaVariance.rotated_real_variance_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (hμ : BorceaVariance.mean q ≠ 0)
  {t₀ : ℝ} (hunit : ∀ (j : Fin m), ‖q j‖ ≤ 1) (ht : ∀ (j : Fin m), t₀ ≤ ‖q j‖ ^ 2) :
  (∀ (j : Fin m),
      BorceaVariance.realCoordinateLower m ‖BorceaVariance.mean q‖ t₀ ≤ (BorceaVariance.rotateToMean q j).re) ∧
    BorceaVariance.realCoordinateVariance (BorceaVariance.rotateToMean q) ‖BorceaVariance.mean q‖ ≤
      min ((↑m - 1) * (1 - ‖BorceaVariance.mean q‖) ^ 2)
        ((1 - ‖BorceaVariance.mean q‖) *
          (‖BorceaVariance.mean q‖ - BorceaVariance.realCoordinateLower m ‖BorceaVariance.mean q‖ t₀))
BorceaVariance.bhatia_davis.{u_1} {ι : Type u_1} (s : Finset ι) (w x : ι → ℝ) {L U b : ℝ} (hw : ∀ i ∈ s, 0 ≤ w i)
  (hx : ∀ i ∈ s, L ≤ x i ∧ x i ≤ U) (hs : ∑ i ∈ s, w i = 1) (hb : ∑ i ∈ s, w i * x i = b) :
  ∑ i ∈ s, w i * (x i - b) ^ 2 ≤ (U - b) * (b - L)
BorceaVariance.inverse_root_centered_sum {m : ℕ} (hm : 0 < m) (d : Fin m → ℂ) (hne : ∀ (j : Fin m), d j ≠ 0) :
  ∑ j, (d j - BorceaVariance.mean d) * ((d j)⁻¹ - BorceaVariance.mean fun i => (d i)⁻¹) =
    ↑m * (1 - BorceaVariance.mean d * BorceaVariance.mean fun i => (d i)⁻¹)
BorceaVariance.inverse_root_cauchy {m : ℕ} (hm : 0 < m) (d : Fin m → ℂ) (hne : ∀ (j : Fin m), d j ≠ 0) :
  ‖1 - BorceaVariance.mean d * BorceaVariance.mean fun i => (d i)⁻¹‖ ^ 2 ≤
    BorceaVariance.centeredVariance d * BorceaVariance.centeredVariance fun i => (d i)⁻¹
BorceaVariance.real_sub_mul_norm_identity (A B : ℝ) (M : ℂ) :
  B - A ^ 2 + ‖↑A - ↑B * M‖ ^ 2 = B * (1 - 2 * A * M.re + B * ‖M‖ ^ 2)
BorceaVariance.inverse_root_covariance {m : ℕ} (hm : 0 < m) (d : Fin m → ℂ) (hne : ∀ (j : Fin m), d j ≠ 0) {A B : ℝ}
  (hA : BorceaVariance.mean d = ↑A) (hB : BorceaVariance.secondMoment d = B) (hC : 0 < B - A ^ 2) :
  1 + ‖↑A - ↑B * BorceaVariance.mean fun i => (d i)⁻¹‖ ^ 2 / (B - A ^ 2) ≤
    B * BorceaVariance.secondMoment fun i => (d i)⁻¹
BorceaVariance.inverse_root_covariance_zero {m : ℕ} (hm : 0 < m) (d : Fin m → ℂ) (hne : ∀ (j : Fin m), d j ≠ 0)
  {A B : ℝ} (hA : BorceaVariance.mean d = ↑A) (hB : BorceaVariance.secondMoment d = B) (hC : B - A ^ 2 = 0) :
  (↑A - ↑B * BorceaVariance.mean fun i => (d i)⁻¹) = 0
BorceaVariance.constant_of_centeredVariance_zero {m : ℕ} (hm : 0 < m) (d : Fin m → ℂ)
  (hv : BorceaVariance.centeredVariance d = 0) (j : Fin m) : d j = BorceaVariance.mean d
BorceaVariance.rootVariance_identity {n : ℕ} (hn : 2 ≤ n) (a : ℝ) :
  BorceaVariance.rootVariance n a = BorceaVariance.rootSecondMoment n a - BorceaVariance.rootMean n a ^ 2
BorceaVariance.rootSecondMoment_pos {n : ℕ} (hn : 2 ≤ n) (a : ℝ) : 0 < BorceaVariance.rootSecondMoment n a
BorceaVariance.normalized_root_mean {n : ℕ} (hn : 2 ≤ n) (a : ℝ) (z : Fin (n - 1) → ℂ) (hcenter : ↑a + ∑ j, z j = 0) :
  (BorceaVariance.mean fun j => ↑a - z j) = ↑(BorceaVariance.rootMean n a)
BorceaVariance.normalized_root_secondMoment {n : ℕ} (hn : 2 ≤ n) (a : ℝ) (z : Fin (n - 1) → ℂ)
  (hcenter : ↑a + ∑ j, z j = 0) (henergy : a ^ 2 + ∑ j, ‖z j‖ ^ 2 = ↑n) :
  (BorceaVariance.secondMoment fun j => ↑a - z j) = BorceaVariance.rootSecondMoment n a
BorceaVariance.normalized_root_variance {n : ℕ} (hn : 2 ≤ n) (a : ℝ) (z : Fin (n - 1) → ℂ) (hcenter : ↑a + ∑ j, z j = 0)
  (henergy : a ^ 2 + ∑ j, ‖z j‖ ^ 2 = ↑n) :
  (BorceaVariance.centeredVariance fun j => ↑a - z j) = BorceaVariance.rootVariance n a
BorceaVariance.normalized_root_product_identity {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  (∏ j, ‖↑Cex.distinguished - z j‖ ^ 2) * ∏ j, ‖BorceaVariance.reciprocalFamily Cex.distinguished ζ j‖ ^ 2 = ↑n ^ 2
BorceaVariance.normalized_root_product {n : ℕ} (hn : 4 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots)
  (hC : 0 < BorceaVariance.rootVariance n Cex.distinguished) :
  ↑n ^ 2 / BorceaVariance.rootSecondMoment n Cex.distinguished ^ (n - 1) *
      (1 +
        BorceaVariance.rootGamma n Cex.distinguished
          (BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ))) ≤
    ∏ j, ‖BorceaVariance.reciprocalFamily Cex.distinguished ζ j‖ ^ 2
BorceaVariance.normalized_root_product_zero {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots)
  (hC : BorceaVariance.rootVariance n Cex.distinguished = 0) :
  ↑(BorceaVariance.rootMean n Cex.distinguished) -
        ↑(BorceaVariance.rootSecondMoment n Cex.distinguished) *
          (BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) / 2) =
      0 ∧
    ∏ j, ‖BorceaVariance.reciprocalFamily Cex.distinguished ζ j‖ ^ 2 =
      ↑n ^ 2 / BorceaVariance.rootSecondMoment n Cex.distinguished ^ (n - 1)
BorceaVariance.normalized_root_product_basic {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  ↑n ^ 2 ≤
    BorceaVariance.rootSecondMoment n Cex.distinguished ^ (n - 1) *
      ∏ j, ‖BorceaVariance.reciprocalFamily Cex.distinguished ζ j‖ ^ 2
BorceaVariance.normalized_root_product_variance_upper {n : ℕ} (hn : 4 ≤ n)
  (Cex : BorceaVariance.NormalizedCounterexample n) (ζ : Fin (n - 1) → ℂ)
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {C : ℝ} (hCpos : 0 < C)
  (hC : BorceaVariance.rootVariance n Cex.distinguished ≤ C) :
  ↑n ^ 2 *
      (1 +
        (↑n - 1) / 3 *
          (‖↑(BorceaVariance.rootMean n Cex.distinguished) -
                  ↑(BorceaVariance.rootSecondMoment n Cex.distinguished) *
                    (BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) / 2)‖ ^
              2 /
            C)) ≤
    BorceaVariance.rootSecondMoment n Cex.distinguished ^ (n - 1) *
      ∏ j, ‖BorceaVariance.reciprocalFamily Cex.distinguished ζ j‖ ^ 2
BorceaVariance.radialLoss_nonneg {m : ℕ} (a : ℝ) (q : Fin m → ℂ) {V : ℝ} (hV : 0 ≤ V) :
  0 ≤ BorceaVariance.radialLoss a q V
BorceaVariance.reciprocal_norm_product_radial_loss {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) {V : ℝ} (hVpos : 0 < V) (hV : BorceaVariance.secondMoment ζ ≤ V) :
  ∏ j, ‖BorceaVariance.reciprocalFamily a ζ j‖ ≤
    BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) ^ (↑m / 2) *
      Real.exp (-BorceaVariance.radialLoss a (BorceaVariance.reciprocalFamily a ζ) V / 2)
BorceaVariance.normalized_stable_product {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {V : ℝ} (hVpos : 0 < V)
  (hV : BorceaVariance.secondMoment ζ ≤ V) :
  ↑n ^ 2 *
      Real.exp (BorceaVariance.radialLoss Cex.distinguished (BorceaVariance.reciprocalFamily Cex.distinguished ζ) V) ≤
    (↑n / (↑n - 1) * (1 + Cex.distinguished ^ 2) *
        BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily Cex.distinguished ζ)) ^
      (n - 1)
BorceaVariance.cofactorSum_zero : BorceaVariance.cofactorSum 0 = 0
BorceaVariance.constantCoeff_linear_product (s : Multiset ℝ) :
  (Multiset.map (fun x => Polynomial.X + Polynomial.C x) s).prod.coeff 0 = s.prod
BorceaVariance.cofactorSum_cons (x : ℝ) (s : Multiset ℝ) :
  BorceaVariance.cofactorSum (x ::ₘ s) = s.prod + x * BorceaVariance.cofactorSum s
BorceaVariance.cofactorSum_eq_esymm (s : Multiset ℝ) (hs : 0 < s.card) :
  BorceaVariance.cofactorSum s = s.esymm (s.card - 1)
BorceaVariance.cofactorSum_tangent_lower (s : Multiset ℝ) (h : ∀ x ∈ s, 0 ≤ x) :
  (2 * ↑s.card - s.sum) * s.prod ≤ BorceaVariance.cofactorSum s
BorceaVariance.cofactorSum_smoothing (s : Multiset ℝ) {x y : ℝ} (hs : ∀ z ∈ s, 0 ≤ z) (hx : x ≤ 1) (hy : 1 ≤ y)
  (hsum : s.sum ≤ ↑s.card + 1) :
  BorceaVariance.cofactorSum (x ::ₘ y ::ₘ s) - (↑s.card - 1) * (x * y * s.prod) ≤
    BorceaVariance.cofactorSum ((x + y - 1) ::ₘ s) - (↑s.card - 2) * ((x + y - 1) * s.prod)
BorceaVariance.cofactorSum_le_normalized (s : Multiset ℝ) (hs : ∀ x ∈ s, 0 ≤ x) (hsum : s.sum = ↑s.card) :
  BorceaVariance.cofactorSum s ≤ 3 + (↑s.card - 3) * s.prod
BorceaVariance.symmetric_inequality (s : Multiset ℝ) (hs : 3 ≤ s.card) (hnonneg : ∀ x ∈ s, 0 ≤ x)
  (hsum : s.sum = ↑s.card) : s.esymm (s.card - 1) ≤ 3 + (↑s.card - 3) * s.prod
BorceaVariance.cofactorSum_eq_product_inverse_sum (s : Multiset ℝ) (hne : ∀ x ∈ s, x ≠ 0) :
  BorceaVariance.cofactorSum s = s.prod * (Multiset.map (fun x => x⁻¹) s).sum
BorceaVariance.symmetric_inverse_product {m : ℕ} (hm : 3 ≤ m) (ξ : Fin m → ℝ) (hpos : ∀ (j : Fin m), 0 < ξ j)
  (hsum : ∑ j, ξ j = ↑m) {δ : ℝ} (hδ : ↑m * (1 + δ) ≤ ∑ j, (ξ j)⁻¹) : (∏ j, ξ j) * (1 + ↑m / 3 * δ) ≤ 1
BorceaVariance.normalized_norm_product_improvement {m : ℕ} (hm : 3 ≤ m) (d : Fin m → ℂ) (hne : ∀ (j : Fin m), d j ≠ 0)
  {B δ : ℝ} (hB : 0 < B) (henergy : ∑ j, ‖d j‖ ^ 2 = ↑m * B)
  (hδ : 1 + δ ≤ B * BorceaVariance.secondMoment fun j => (d j)⁻¹) : (∏ j, ‖d j‖ ^ 2) * (1 + ↑m / 3 * δ) ≤ B ^ m
BorceaVariance.real_tao_product.{u_1} {ι : Type u_1} (S : Finset ι) (f : ι → ℝ) (hpos : ∀ j ∈ S, 0 < f j)
  (hle : ∀ j ∈ S, f j ≤ 1) : (∏ j ∈ S, f j) * ∑ j ∈ S, ((f j)⁻¹ - f j) ≤ 1 - (∏ j ∈ S, f j) ^ 2
BorceaVariance.inverse_conjugate_norm {z : ℂ} (hz : z ≠ 0) (hz1 : ‖z‖ ≤ 1) : ‖z⁻¹ - (starRingEnd ℂ) z‖ = ‖z‖⁻¹ - ‖z‖
BorceaVariance.tao_product {m : ℕ} (ξ : Fin m → ℂ) (hpos : ∀ (j : Fin m), 0 < ‖ξ j‖) (hle : ∀ (j : Fin m), ‖ξ j‖ ≤ 1) :
  (∏ j, ‖ξ j‖) * ∑ j, ‖(ξ j)⁻¹ - (starRingEnd ℂ) (ξ j)‖ ≤ 1 - ∏ j, ‖ξ j‖ ^ 2
BorceaVariance.toeplitz_corollary {n : ℕ} (hn : 2 ≤ n) (a : Fin (n + 1) → ℂ) :
  ∃ μ, (∃ v, v ≠ 0 ∧ (BorceaVariance.toeplitzMatrix a).mulVec v = μ • v) ∧ ‖μ - ∑ k, a k‖ ^ 2 ≤ ∑ j, ‖a j.succ‖ ^ 2
BorceaVariance.variance_shift_identity (p : Polynomial ℂ) (hn : 0 < p.natDegree) (c : ℂ) :
  (Multiset.map (fun z => ‖z - c‖ ^ 2) p.roots).sum / ↑p.natDegree =
    BorceaVariance.variance p + ‖c - BorceaVariance.centroid p‖ ^ 2
BorceaVariance.centroid_minimizes_variance (p : Polynomial ℂ) (hn : 0 < p.natDegree) (c : ℂ) :
  BorceaVariance.variance p ≤ (Multiset.map (fun z => ‖z - c‖ ^ 2) p.roots).sum / ↑p.natDegree
BorceaVariance.centroid_unique_minimizer (p : Polynomial ℂ) (hn : 0 < p.natDegree) (c : ℂ) :
  (Multiset.map (fun z => ‖z - c‖ ^ 2) p.roots).sum / ↑p.natDegree = BorceaVariance.variance p ↔
    c = BorceaVariance.centroid p
BorceaVariance.sigma2_eq_infimum (p : Polynomial ℂ) (hn : 0 < p.natDegree) :
  BorceaVariance.sigma2 p =
    sInf (Set.range fun c => √((Multiset.map (fun z => ‖z - c‖ ^ 2) p.roots).sum / ↑p.natDegree))
BorceaVariance.variance_raw_moment (p : Polynomial ℂ) (hn : 0 < p.natDegree) :
  BorceaVariance.variance p =
    (Multiset.map (fun z => ‖z‖ ^ 2) p.roots).sum / ↑p.natDegree - ‖BorceaVariance.centroid p‖ ^ 2
BorceaVariance.main_theorem (p : Polynomial ℂ) (hn : 2 ≤ p.natDegree) (a : ℂ) (ha : Polynomial.eval a p = 0) :
  ∃ z, Polynomial.eval z (Polynomial.derivative p) = 0 ∧ ‖a - z‖ ≤ BorceaVariance.sigma2 p
BorceaVariance.main_statement : BorceaVariance.MainStatement
BorceaVariance.toeplitz_corollary {n : ℕ} (hn : 2 ≤ n) (a : Fin (n + 1) → ℂ) :
  ∃ μ, (∃ v, v ≠ 0 ∧ (BorceaVariance.toeplitzMatrix a).mulVec v = μ • v) ∧ ‖μ - ∑ k, a k‖ ^ 2 ≤ ∑ j, ‖a j.succ‖ ^ 2
BorceaVariance.normalized_reciprocal_moments {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  have a := Cex.distinguished;
  have q := BorceaVariance.reciprocalFamily a ζ;
  have μ := BorceaVariance.mean q;
  have s := BorceaVariance.secondMoment q;
  have v := BorceaVariance.centeredVariance q;
  have V := 1 - 1 / (↑n - 1);
  ‖μ‖ ^ 2 + (1 - V) * (1 - s) ≤ 2 * a * μ.re - a ^ 2 * s ∧
    ‖μ - ↑a‖ ^ 2 ≤ (a ^ 2 + V - 1) * (1 - s) ∧
      ‖1 - ↑a * μ‖ ^ 2 ≤ V * v ∧ 1 ≤ s * (a ^ 2 + V) ∧ BorceaVariance.beta a μ s 1 ≤ (a ^ 2 + V) * v
BorceaVariance.normalized_origin_identity_fin {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  ↑n *
      ∫ (t : ℝ) in 0..1,
        BorceaVariance.originProduct (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished t =
    (-1) ^ (n - 1) * BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)
BorceaVariance.differential_identity {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a : ℝ) :
  (BorceaVariance.originProduct q a 1 +
        ↑m * ↑a * BorceaVariance.mean q * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t) +
      BorceaVariance.originRemainder q a =
    1
BorceaVariance.normalized_center_identity_fin {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  have a := Cex.distinguished;
  have q := BorceaVariance.reciprocalFamily a ζ;
  have μ := BorceaVariance.mean q;
  have J := BorceaVariance.jointProduct z q;
  (-1) ^ (n - 1) * ↑a * μ * J + (1 - ↑a * μ) ^ n -
      ↑n * ↑a * μ * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t - (1 - ↑a * μ * ↑t) ^ (n - 1) =
    1
BorceaVariance.normalized_core_product {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z q : Fin (n - 1) → ℂ) (henergy : Cex.distinguished ^ 2 + ∑ j, ‖z j‖ ^ 2 = ↑n) :
  ‖↑Cex.distinguished * BorceaVariance.mean q * BorceaVariance.jointProduct z q‖ ≤
    BorceaVariance.Phi (n - 1) Cex.distinguished * ‖BorceaVariance.mean q‖ * ∏ j, ‖q j‖
BorceaVariance.normalized_basic_product {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  ↑n ^ 2 ≤
    (↑n / (↑n - 1) * (1 + Cex.distinguished ^ 2) *
        BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily Cex.distinguished ζ)) ^
      (n - 1)
BorceaVariance.phi_mono_degree {m k : ℕ} (hm : 0 < m) (hmk : m ≤ k) {a : ℝ} (ha : 0 ≤ a) (hdom : a ^ 2 ≤ ↑m) :
  BorceaVariance.Phi m a ≤ BorceaVariance.Phi k a
BorceaVariance.phi_mono_before_one {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ 1) :
  BorceaVariance.Phi m a ≤ BorceaVariance.Phi m b
BorceaVariance.phi_antitone_after_one {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 1 ≤ a) (hab : a ≤ b) (hb : b ^ 2 ≤ ↑m) :
  BorceaVariance.Phi m b ≤ BorceaVariance.Phi m a
BorceaVariance.direct_bound {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) (hq : ∀ (j : Fin m), ‖q j‖ ≤ 1) {a t B L : ℝ}
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  BorceaVariance.directMajorant q a t ≤
    ↑m *
      min (min 1 (BorceaVariance.omissionConstant m 1 * BorceaVariance.secondMoment q) * B ^ (↑(m - 1) / 2))
        (min 1 (BorceaVariance.omissionConstant m 1 ^ 2 * BorceaVariance.secondMoment q) * L ^ (m - 1))
BorceaVariance.direct_retained_bound {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) (hq : ∀ (j : Fin m), ‖q j‖ ≤ 1)
  {a aUpper t u B L : ℝ} (ha : 0 ≤ a) (haUpper : a ≤ aUpper) (ht : 0 ≤ t) (htu : t ≤ u)
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  have δ := max 0 (1 - aUpper * u);
  BorceaVariance.directMajorant q a t ≤
    ↑m * BorceaVariance.secondMoment q *
      min (max 0 ((↑m * B - δ ^ 2) / ↑(m - 1)) ^ (↑(m - 1) / 2)) (max 0 ((↑m * L - δ) / ↑(m - 1)) ^ (m - 1))
BorceaVariance.centered_interpolation_first {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) {a t B L : ℝ}
  (hD : 1 - ↑a * ↑t * BorceaVariance.mean q ≠ 0)
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  ‖BorceaVariance.originProduct q a t - (1 - ↑a * ↑t * BorceaVariance.mean q) ^ m‖ ≤
    ↑m * a ^ 2 * t ^ 2 * BorceaVariance.centeredVariance q / (2 * ‖1 - ↑a * ↑t * BorceaVariance.mean q‖) *
      min (BorceaVariance.omissionConstant m 1 * B ^ (↑(m - 1) / 2))
        (BorceaVariance.omissionConstant m 1 ^ 2 * L ^ (m - 1))
BorceaVariance.centered_interpolation_second {m : ℕ} (hm : 3 ≤ m) (q : Fin m → ℂ) {a t B L : ℝ}
  (hB : BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t ≤ B)
  (hL : BorceaVariance.factorMean q a t ≤ L) :
  ‖BorceaVariance.originProduct q a t - (1 - ↑a * ↑t * BorceaVariance.mean q) ^ m‖ ≤
    ↑m * ↑(m - 1) * a ^ 2 * t ^ 2 * BorceaVariance.centeredVariance q / 2 *
      min (BorceaVariance.omissionConstant m 2 * B ^ (↑(m - 2) / 2))
        (BorceaVariance.omissionConstant m 2 ^ 2 * L ^ (m - 2))
BorceaVariance.normalized_direct_integral_test {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {κ Cbound : ℝ}
  (hκ : BorceaVariance.factorMean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished 1 ≤ κ)
  (hC :
    ‖↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤
      Cbound) :
  1 ≤
    κ ^ (n - 1) + ↑(n - 1) / ↑n * Cbound +
      Cex.distinguished ^ 2 *
        ∫ (t : ℝ) in 0..1,
          t * BorceaVariance.directMajorant (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished t
BorceaVariance.normalized_absolute_integral_test {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {Cbound : ℝ}
  (hC :
    ‖↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤
      Cbound)
  (U : ℝ → ℝ) (hi : IntervalIntegrable (fun t => t ^ 2 * U t) MeasureTheory.volume 0 1)
  (hU :
    ∀ t ∈ Set.Icc 0 1,
      ‖BorceaVariance.centeredError (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished t‖ ≤
        Cex.distinguished ^ 2 * t ^ 2 *
            BorceaVariance.centeredVariance (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          U t) :
  have q := BorceaVariance.reciprocalFamily Cex.distinguished ζ;
  1 ≤
    Cbound + ((1 - 1 / (↑n - 1)) * BorceaVariance.centeredVariance q) ^ (↑n / 2) +
      BorceaVariance.centerIntegralCoefficient (n - 1) Cex.distinguished ‖BorceaVariance.mean q‖ U *
        BorceaVariance.centeredVariance q
BorceaVariance.normalized_ratio_integral_test {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (henergy : Cex.distinguished ^ 2 + ∑ j, ‖z j‖ ^ 2 = ↑n)
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) (U : ℝ → ℝ)
  (hi : IntervalIntegrable (fun t => t ^ 2 * U t) MeasureTheory.volume 0 1) (hU0 : ∀ t ∈ Set.Icc 0 1, 0 ≤ U t)
  (hU :
    ∀ t ∈ Set.Icc 0 1,
      ‖BorceaVariance.centeredError (BorceaVariance.reciprocalFamily Cex.distinguished ζ) Cex.distinguished t‖ ≤
        Cex.distinguished ^ 2 * t ^ 2 *
            BorceaVariance.centeredVariance (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          U t) :
  have q := BorceaVariance.reciprocalFamily Cex.distinguished ζ;
  1 ≤
    (1 + ‖BorceaVariance.mean q‖) *
      ((1 - 1 / (↑n - 1)) ^ (↑n / 2) * (1 - ‖BorceaVariance.mean q‖ ^ 2) ^ (↑(n - 2) / 2) +
        BorceaVariance.centerIntegralCoefficient (n - 1) Cex.distinguished ‖BorceaVariance.mean q‖ U)
BorceaVariance.no_normalized_counterexample_large {n : ℕ} (hn : 100001 ≤ n)
  (Cex : BorceaVariance.NormalizedCounterexample n) : False
BorceaVariance.large_degree_main (p : Polynomial ℂ) (hn : 100001 ≤ p.natDegree) (a : ℂ) (ha : Polynomial.eval a p = 0) :
  ∃ z, Polynomial.eval z (Polynomial.derivative p) = 0 ∧ ‖a - z‖ ≤ BorceaVariance.sigma2 p
BorceaVariance.symmetric_inequality (s : Multiset ℝ) (hs : 3 ≤ s.card) (hnonneg : ∀ x ∈ s, 0 ≤ x)
  (hsum : s.sum = ↑s.card) : s.esymm (s.card - 1) ≤ 3 + (↑s.card - 3) * s.prod
BorceaVariance.normalized_inverse_root_mean {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  (BorceaVariance.mean fun j => (↑Cex.distinguished - z j)⁻¹) =
    BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) / 2
BorceaVariance.normalized_root_product {n : ℕ} (hn : 4 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots)
  (hC : 0 < BorceaVariance.rootVariance n Cex.distinguished) :
  ↑n ^ 2 / BorceaVariance.rootSecondMoment n Cex.distinguished ^ (n - 1) *
      (1 +
        BorceaVariance.rootGamma n Cex.distinguished
          (BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ))) ≤
    ∏ j, ‖BorceaVariance.reciprocalFamily Cex.distinguished ζ j‖ ^ 2
BorceaVariance.normalized_root_product_zero {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots)
  (hC : BorceaVariance.rootVariance n Cex.distinguished = 0) :
  ↑(BorceaVariance.rootMean n Cex.distinguished) -
        ↑(BorceaVariance.rootSecondMoment n Cex.distinguished) *
          (BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) / 2) =
      0 ∧
    ∏ j, ‖BorceaVariance.reciprocalFamily Cex.distinguished ζ j‖ ^ 2 =
      ↑n ^ 2 / BorceaVariance.rootSecondMoment n Cex.distinguished ^ (n - 1)
BorceaVariance.reciprocal_radial_loss {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) {V : ℝ} (hVpos : 0 < V) (hV : BorceaVariance.secondMoment ζ ≤ V) :
  ∏ j, ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2 ≤
    BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) ^ m *
