BorceaVariance.quadratic_main (p : Polynomial ℂ) (hn : p.natDegree = 2) (a : ℂ) (ha : Polynomial.eval a p = 0) :
  ∃ z, Polynomial.eval z (Polynomial.derivative p) = 0 ∧ ‖a - z‖ ≤ BorceaVariance.sigma2 p
BorceaVariance.elementarySymmetric_two_identity {m : ℕ} (w : Fin m → ℂ) :
  2 * BorceaVariance.elementarySymmetric w 2 = (∑ j, w j) ^ 2 - ∑ j, w j ^ 2
BorceaVariance.centered_elementarySymmetric_two {m : ℕ} (w : Fin m → ℂ) (hcenter : ∑ j, w j = 0) :
  BorceaVariance.elementarySymmetric w 2 = (-∑ j, w j ^ 2) / 2
BorceaVariance.centered_elementarySymmetric_two_real {m : ℕ} (w : Fin m → ℂ) (hcenter : ∑ j, w j = 0) :
  (BorceaVariance.elementarySymmetric w 2).re = (∑ j, ‖w j‖ ^ 2) / 2 - ∑ j, (w j).re ^ 2
BorceaVariance.rotateToMean_centered {m : ℕ} (q : Fin m → ℂ) (hμ : BorceaVariance.mean q ≠ 0) (j : Fin m) :
  BorceaVariance.rotateToMean q j - ↑‖BorceaVariance.mean q‖ =
