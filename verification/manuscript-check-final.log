BorceaVariance.cubic_main (p : Polynomial ℂ) (hn : p.natDegree = 3) (a : ℂ) (ha : Polynomial.eval a p = 0) :
  ∃ z, Polynomial.eval z (Polynomial.derivative p) = 0 ∧ ‖a - z‖ ≤ BorceaVariance.sigma2 p
