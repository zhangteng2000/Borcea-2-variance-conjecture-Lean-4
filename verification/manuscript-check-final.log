  (hK : Kmin ≤ BorceaVariance.realQuadraticKernel m (a * ‖BorceaVariance.mean q‖)) (hK0 : 0 ≤ Kmin)
  (hL :
    L ≤ (BorceaVariance.elementarySymmetric (fun j => BorceaVariance.rotateToMean q j - ↑‖BorceaVariance.mean q‖) 2).re)
  (hL0 : 0 ≤ L) :
  Kmin * L -
      ↑m / 2 * BorceaVariance.centeredVariance q * BorceaVariance.phaseError m (a * ‖BorceaVariance.mean q‖) d ε ≤
    (BorceaVariance.elementarySymmetric (fun j => q j - BorceaVariance.mean q) 2 *
        BorceaVariance.quadraticKernel m (↑a * BorceaVariance.mean q)).re
BorceaVariance.signed_coefficient_integral_test {m : ℕ} (hm : 2 ≤ m) (q : Fin m → ℂ) (hμ : BorceaVariance.mean q ≠ 0)
  {a d ε Kmin L Cbound : ℝ} (ha : 0 ≤ a) (hh1 : a * ‖BorceaVariance.mean q‖ ≤ 1)
  (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) (hε : ‖BorceaVariance.meanPhase q - 1‖ ≤ ε)
  (hK : Kmin ≤ BorceaVariance.realQuadraticKernel m (a * ‖BorceaVariance.mean q‖)) (hK0 : 0 ≤ Kmin)
  (hL :
    L ≤ (BorceaVariance.elementarySymmetric (fun j => BorceaVariance.rotateToMean q j - ↑‖BorceaVariance.mean q‖) 2).re)
  (hL0 : 0 ≤ L) (J : ℂ) (horigin : ↑(m + 1) * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t = (-1) ^ m * J)
  (hC : ‖↑a * BorceaVariance.mean q * J‖ ≤ Cbound) :
  1 ≤
    Cbound + d ^ (m + 1) - a ^ 2 * Kmin * L +
        ↑m * a ^ 2 * BorceaVariance.centeredVariance q / 2 *
          BorceaVariance.phaseError m (a * ‖BorceaVariance.mean q‖) d ε +
      a * ‖BorceaVariance.mean q‖ *
        ∑ k ∈ Finset.Ico 3 (m + 1),
          (a ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑m - 1)) ^ (↑k / 2) *
            BorceaVariance.integralPowerSum k (m - k) d
BorceaVariance.normalized_signed_coefficient_test {n : ℕ} (hn : 4 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {d ε Kmin L Cbound : ℝ}
  (hh : 0 < Cex.distinguished * ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖)
  (hh1 : Cex.distinguished * ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤ 1)
  (hd : ‖1 - ↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤ d)
  (hε : ‖BorceaVariance.meanPhase (BorceaVariance.reciprocalFamily Cex.distinguished ζ) - 1‖ ≤ ε)
  (hK :
    Kmin ≤
      BorceaVariance.realQuadraticKernel (n - 1)
        (Cex.distinguished * ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖))
  (hK0 : 0 ≤ Kmin)
  (hL :
    L ≤
      (BorceaVariance.elementarySymmetric
          (fun j =>
            BorceaVariance.rotateToMean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) j -
              ↑‖BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖)
          2).re)
  (hL0 : 0 < L)
  (hC :
    ‖↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤
      Cbound) :
  have q := BorceaVariance.reciprocalFamily Cex.distinguished ζ;
  1 ≤
    Cbound + d ^ n - Cex.distinguished ^ 2 * Kmin * L +
        (↑n - 1) * Cex.distinguished ^ 2 * BorceaVariance.centeredVariance q / 2 *
          BorceaVariance.phaseError (n - 1) (Cex.distinguished * ‖BorceaVariance.mean q‖) d ε +
      Cex.distinguished * ‖BorceaVariance.mean q‖ *
        ∑ k ∈ Finset.Ico 3 n,
          (Cex.distinguished ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑n - 2)) ^ (↑k / 2) *
            BorceaVariance.integralPowerSum k (n - 1 - k) d
BorceaVariance.complex_pow_difference_bound (A B : ℂ) {R : ℝ} (hA : ‖A‖ ≤ R) (hB : ‖B‖ ≤ R) (p : ℕ) :
  ‖A ^ p - B ^ p‖ ≤ ↑p * ‖A - B‖ * R ^ (p - 1)
BorceaVariance.unit_cube_difference_bound {u : ℂ} (hu : ‖u‖ = 1) : ‖u ^ 3 - 1‖ ≤ 3 * ‖u - 1‖
BorceaVariance.phase_integrand_bound {u : ℂ} (hu : ‖u‖ = 1) {h d ε t : ℝ} (hh : 0 ≤ h) (hh1 : h ≤ 1)
  (hd : ‖1 - ↑h * u‖ ≤ d) (hε : ‖u - 1‖ ≤ ε) (ht : 0 ≤ t) (ht1 : t ≤ 1) (p : ℕ) :
  ‖u ^ 3 * (1 - ↑h * u * ↑t) ^ p - (1 - ↑h * ↑t) ^ p‖ ≤
    ε * (3 * (1 - t + d * t) ^ p + ↑p * h * t * (1 - t + d * t) ^ (p - 1))
BorceaVariance.quadraticKernel_real (m : ℕ) (h : ℝ) :
  BorceaVariance.quadraticKernel m ↑h = ↑(BorceaVariance.realQuadraticKernel m h)
BorceaVariance.realQuadraticKernel_nonneg (m : ℕ) {h : ℝ} (hh : 0 ≤ h) (hh1 : h ≤ 1) :
  0 ≤ BorceaVariance.realQuadraticKernel m h
BorceaVariance.phase_integral_bound (m : ℕ) {u : ℂ} (hu : ‖u‖ = 1) {h d ε : ℝ} (hh : 0 ≤ h) (hh1 : h ≤ 1)
  (hd : ‖1 - ↑h * u‖ ≤ d) (hε : ‖u - 1‖ ≤ ε) :
