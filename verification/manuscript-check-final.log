  Polynomial.derivative Cex.polynomial = Polynomial.C ↑n * ∏ j, (Polynomial.X - Polynomial.C (ζ j))
BorceaVariance.normalized_product_identity {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n)
  (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
