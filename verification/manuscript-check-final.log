BorceaVariance.circulant_row_sum_isRoot {n : ℕ} (a : Fin (n + 1) → ℂ) :
  Polynomial.eval (∑ j, a j) (BorceaVariance.circulantMatrix a).charpoly = 0
BorceaVariance.circulant_trace {n : ℕ} (a : Fin (n + 1) → ℂ) : (BorceaVariance.circulantMatrix a).trace = (↑n + 1) * a 0
BorceaVariance.circulant_centroid {n : ℕ} (a : Fin (n + 1) → ℂ) :
  BorceaVariance.centroid (BorceaVariance.circulantMatrix a).charpoly = a 0
BorceaVariance.circulant_frobenius {n : ℕ} (a : Fin (n + 1) → ℂ) :
  BorceaVariance.frobeniusSquare (BorceaVariance.circulantMatrix a) = (↑n + 1) * ∑ j, ‖a j‖ ^ 2
BorceaVariance.circulant_variance_le {n : ℕ} (a : Fin (n + 1) → ℂ) :
  BorceaVariance.variance (BorceaVariance.circulantMatrix a).charpoly ≤ ∑ j, ‖a j.succ‖ ^ 2
BorceaVariance.complex_pair_conjugate_iff_real_line {n : ℕ} (z : Fin n → ℂ) :
  (∀ (i j : Fin n), z i * (starRingEnd ℂ) (z j) = (starRingEnd ℂ) (z i) * z j) ↔ ∃ v t, ∀ (j : Fin n), z j = ↑(t j) * v
BorceaVariance.centered_collinear_iff_real_line {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) (hcenter : ∑ j, z j = 0) :
  Collinear ℝ (Set.range z) ↔ ∃ v t, ∀ (j : Fin n), z j = ↑(t j) * v
BorceaVariance.centered_collinear_iff_pair_conjugate {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) (hcenter : ∑ j, z j = 0) :
  Collinear ℝ (Set.range z) ↔ ∀ (i j : Fin n), z i * (starRingEnd ℂ) (z j) = (starRingEnd ℂ) (z i) * z j
BorceaVariance.compression_entry_norm {n : ℕ} (z : Fin n → ℂ) (i j : Fin n) :
  ‖BorceaVariance.centeredCompression z i j‖ ^ 2 =
    (if i = j then ‖z i‖ ^ 2 - 4 * ‖z i‖ ^ 2 / ↑n else 0) + ‖z i + z j‖ ^ 2 / ↑n ^ 2
BorceaVariance.centered_pair_norm_sum {n : ℕ} (z : Fin n → ℂ) (hcenter : ∑ i, z i = 0) (i : Fin n) :
  ∑ j, ‖z i + z j‖ ^ 2 = ↑n * ‖z i‖ ^ 2 + ∑ j, ‖z j‖ ^ 2
BorceaVariance.centered_compression_frobenius {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) (hcenter : ∑ i, z i = 0) :
  BorceaVariance.frobeniusSquare (BorceaVariance.centeredCompression z) = (↑n - 2) / ↑n * ∑ i, ‖z i‖ ^ 2
BorceaVariance.uniformProjection_row_sum {n : ℕ} (hn : 0 < n) (i : Fin n) :
  ∑ j, BorceaVariance.uniformProjection n i j = 0
BorceaVariance.compression_row_sum {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) (hcenter : ∑ i, z i = 0) (i : Fin n) :
  ∑ j, BorceaVariance.centeredCompression z i j = 0
BorceaVariance.uniformProjection_idempotent {n : ℕ} (hn : 0 < n) :
  BorceaVariance.uniformProjection n * BorceaVariance.uniformProjection n = BorceaVariance.uniformProjection n
BorceaVariance.centeredCompression_eq_projection_diagonal {n : ℕ} (z : Fin n → ℂ) (hcenter : ∑ i, z i = 0) :
  BorceaVariance.centeredCompression z =
    BorceaVariance.uniformProjection n * Matrix.diagonal z * BorceaVariance.uniformProjection n
BorceaVariance.charpoly_eval_projection_diagonal {n : ℕ} (z : Fin n → ℂ) (x : ℂ) (hx : ∀ (i : Fin n), x - z i ≠ 0) :
  Polynomial.eval x (BorceaVariance.uniformProjection n * Matrix.diagonal z).charpoly =
    (∏ i, (x - z i)) * (1 + ∑ i, z i / ↑n / (x - z i))
BorceaVariance.root_product_derivative_eval {n : ℕ} (z : Fin n → ℂ) (x : ℂ) (hx : ∀ (i : Fin n), x - z i ≠ 0) :
  Polynomial.eval x (Polynomial.derivative (∏ i, (Polynomial.X - Polynomial.C (z i)))) =
    (∏ i, (x - z i)) * ∑ i, (x - z i)⁻¹
BorceaVariance.projection_diagonal_charpoly {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) :
  (BorceaVariance.uniformProjection n * Matrix.diagonal z).charpoly =
    Polynomial.C (↑n)⁻¹ * Polynomial.X * Polynomial.derivative (∏ i, (Polynomial.X - Polynomial.C (z i)))
BorceaVariance.centered_compression_charpoly {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) (hz : ∑ i, z i = 0) :
  (BorceaVariance.centeredCompression z).charpoly =
    Polynomial.C (↑n)⁻¹ * Polynomial.X * Polynomial.derivative (∏ i, (Polynomial.X - Polynomial.C (z i)))
BorceaVariance.centered_compression_conjTranspose {n : ℕ} (z : Fin n → ℂ) :
  (BorceaVariance.centeredCompression z).conjTranspose =
    BorceaVariance.centeredCompression fun j => (starRingEnd ℂ) (z j)
BorceaVariance.centered_compression_mul_entry {n : ℕ} (hn : 0 < n) (z w : Fin n → ℂ) (hz : ∑ j, z j = 0)
  (hw : ∑ j, w j = 0) (i j : Fin n) :
  ↑n ^ 2 * (BorceaVariance.centeredCompression z * BorceaVariance.centeredCompression w) i j =
    (if i = j then ↑n ^ 2 * z i * w i else 0) - ↑n * (z i * w i + z j * w j + z i * w j) + ∑ k, z k * w k
BorceaVariance.centered_compression_commutator {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) (hz : ∑ j, z j = 0) (i j : Fin n) :
  ↑n ^ 2 *
      ((BorceaVariance.centeredCompression z * (BorceaVariance.centeredCompression z).conjTranspose) i j -
        ((BorceaVariance.centeredCompression z).conjTranspose * BorceaVariance.centeredCompression z) i j) =
    -↑n * (z i * (starRingEnd ℂ) (z j) - (starRingEnd ℂ) (z i) * z j)
BorceaVariance.centered_compression_normal_iff_pair {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) (hz : ∑ j, z j = 0) :
  BorceaVariance.centeredCompression z * (BorceaVariance.centeredCompression z).conjTranspose =
      (BorceaVariance.centeredCompression z).conjTranspose * BorceaVariance.centeredCompression z ↔
    ∀ (i j : Fin n), z i * (starRingEnd ℂ) (z j) = (starRingEnd ℂ) (z i) * z j
BorceaVariance.det_diagonal_add_row {n : ℕ} (d v : Fin n → ℂ) (hd : ∀ (i : Fin n), d i ≠ 0) :
  (Matrix.diagonal d + Matrix.of fun x j => v j).det = (∏ i, d i) * (1 + ∑ i, v i / d i)
BorceaVariance.frobeniusSquare_eq_trace {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) :
  BorceaVariance.frobeniusSquare A = (A * A.conjTranspose).trace.re
BorceaVariance.frobeniusSquare_nonneg {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) : 0 ≤ BorceaVariance.frobeniusSquare A
BorceaVariance.frobeniusSquare_unitary_similarity {n : ℕ} (A U : Matrix (Fin n) (Fin n) ℂ)
  (hU : U * U.conjTranspose = 1) :
  BorceaVariance.frobeniusSquare (U.conjTranspose * A * U) = BorceaVariance.frobeniusSquare A
BorceaVariance.diagonal_energy_le_frobeniusSquare {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) :
  ∑ i, ‖A i i‖ ^ 2 ≤ BorceaVariance.frobeniusSquare A
BorceaVariance.unitary_normal_similarity_iff {n : ℕ} (A U : Matrix (Fin n) (Fin n) ℂ) (hU : U * U.conjTranspose = 1) :
  U.conjTranspose * A * U * (U.conjTranspose * A * U).conjTranspose =
      (U.conjTranspose * A * U).conjTranspose * (U.conjTranspose * A * U) ↔
    A * A.conjTranspose = A.conjTranspose * A
BorceaVariance.first_block_normal_iff {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (μ : ℂ)
  (hcol : ∀ (i : Fin (n + 1)), A i 0 = if i = 0 then μ else 0)
  (hrow : ∀ (j : Fin (n + 1)), A 0 j = if j = 0 then μ else 0) :
  have B := A.submatrix Fin.succ Fin.succ;
  A * A.conjTranspose = A.conjTranspose * A ↔ B * B.conjTranspose = B.conjTranspose * B
BorceaVariance.first_column_row_of_frobenius_eq {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (μ : ℂ)
  (hcol : ∀ (i : Fin (n + 1)), A i 0 = if i = 0 then μ else 0)
  (hF : BorceaVariance.frobeniusSquare A = ‖μ‖ ^ 2 + BorceaVariance.frobeniusSquare (A.submatrix Fin.succ Fin.succ))
  (j : Fin (n + 1)) : A 0 j = if j = 0 then μ else 0
BorceaVariance.normal_row_energy_eq_column_energy {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
  (hA : A * A.conjTranspose = A.conjTranspose * A) (i : Fin n) : ∑ j, ‖A i j‖ ^ 2 = ∑ j, ‖A j i‖ ^ 2
BorceaVariance.first_column_normal_row {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (μ : ℂ)
  (hA : A * A.conjTranspose = A.conjTranspose * A) (hcol : ∀ (i : Fin (n + 1)), A i 0 = if i = 0 then μ else 0)
  (j : Fin (n + 1)) : A 0 j = if j = 0 then μ else 0
BorceaVariance.first_block_frobenius_eq {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (μ : ℂ)
  (hcol : ∀ (i : Fin (n + 1)), A i 0 = if i = 0 then μ else 0)
  (hrow : ∀ (j : Fin (n + 1)), A 0 j = if j = 0 then μ else 0) :
  BorceaVariance.frobeniusSquare A = ‖μ‖ ^ 2 + BorceaVariance.frobeniusSquare (A.submatrix Fin.succ Fin.succ)
BorceaVariance.first_block_normal {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (μ : ℂ)
  (hA : A * A.conjTranspose = A.conjTranspose * A) (hcol : ∀ (i : Fin (n + 1)), A i 0 = if i = 0 then μ else 0)
  (hrow : ∀ (j : Fin (n + 1)), A 0 j = if j = 0 then μ else 0) :
  have B := A.submatrix Fin.succ Fin.succ;
  B * B.conjTranspose = B.conjTranspose * B
BorceaVariance.schur_frobenius_bound {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) :
  (Multiset.map (fun z => ‖z‖ ^ 2) A.charpoly.roots).sum ≤ BorceaVariance.frobeniusSquare A
BorceaVariance.schur_frobenius_eq_iff_normal {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) :
  (Multiset.map (fun z => ‖z‖ ^ 2) A.charpoly.roots).sum = BorceaVariance.frobeniusSquare A ↔
    A * A.conjTranspose = A.conjTranspose * A
BorceaVariance.exists_orthonormal_eigenbasis_first.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [FiniteDimensional ℂ E] {n : ℕ} (hdim : Module.finrank ℂ E = n + 1) (f : Module.End ℂ E) : ∃ μ b, f (b 0) = μ • b 0
BorceaVariance.eigenbasis_first_column.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {n : ℕ}
  (f : Module.End ℂ E) (b : OrthonormalBasis (Fin (n + 1)) ℂ E) (μ : ℂ) (hμ : f (b 0) = μ • b 0) (i : Fin (n + 1)) :
  (LinearMap.toMatrix b.toBasis b.toBasis) f i 0 = if i = 0 then μ else 0
BorceaVariance.orthonormal_change_matrix.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {n : ℕ}
  (a b : OrthonormalBasis (Fin n) ℂ E) (f : Module.End ℂ E) :
  (LinearMap.toMatrix b.toBasis b.toBasis) f =
    (a.toBasis.toMatrix ⇑b).conjTranspose * (LinearMap.toMatrix a.toBasis a.toBasis) f * a.toBasis.toMatrix ⇑b
BorceaVariance.first_column_charpoly {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (μ : ℂ)
  (hcol : ∀ (i : Fin (n + 1)), A i 0 = if i = 0 then μ else 0) :
  A.charpoly = (Polynomial.X - Polynomial.C μ) * (A.submatrix Fin.succ Fin.succ).charpoly
BorceaVariance.first_block_frobenius_le {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) :
  ‖A 0 0‖ ^ 2 + BorceaVariance.frobeniusSquare (A.submatrix Fin.succ Fin.succ) ≤ BorceaVariance.frobeniusSquare A
BorceaVariance.circulant_critical_roots {n : ℕ} (a : Fin (n + 1) → ℂ) :
  (Polynomial.derivative (BorceaVariance.circulantMatrix a).charpoly).roots =
    (BorceaVariance.toeplitzMatrix a).charpoly.roots
BorceaVariance.circulant_critical_iff_toeplitz_root {n : ℕ} (a : Fin (n + 1) → ℂ) (μ : ℂ) :
  Polynomial.eval μ (Polynomial.derivative (BorceaVariance.circulantMatrix a).charpoly) = 0 ↔
    Polynomial.eval μ (BorceaVariance.toeplitzMatrix a).charpoly = 0
BorceaVariance.matrix_root_eigenvector {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (μ : ℂ)
  (hμ : Polynomial.eval μ A.charpoly = 0) : ∃ v, v ≠ 0 ∧ A.mulVec v = μ • v
BorceaVariance.circulant_critical_toeplitz_eigenvector {n : ℕ} (a : Fin (n + 1) → ℂ) (μ : ℂ)
  (hμ : Polynomial.eval μ (Polynomial.derivative (BorceaVariance.circulantMatrix a).charpoly) = 0) :
  ∃ v, v ≠ 0 ∧ (BorceaVariance.toeplitzMatrix a).mulVec v = μ • v
BorceaVariance.circulant_radius_to_squared_bound {n : ℕ} (a : Fin (n + 1) → ℂ) (μ : ℂ)
  (h : ‖∑ k, a k - μ‖ ≤ BorceaVariance.sigma2 (BorceaVariance.circulantMatrix a).charpoly) :
  ‖μ - ∑ k, a k‖ ^ 2 ≤ ∑ j, ‖a j.succ‖ ^ 2
BorceaVariance.main_theorem (p : Polynomial ℂ) (hn : 2 ≤ p.natDegree) (a : ℂ) (ha : Polynomial.eval a p = 0) :
  ∃ z, Polynomial.eval z (Polynomial.derivative p) = 0 ∧ ‖a - z‖ ≤ BorceaVariance.sigma2 p
BorceaVariance.main_statement : BorceaVariance.MainStatement
BorceaVariance.exists_normalizing_scale (w : ℂ) (s : ℝ) (hs : 0 < s) : ∃ b r, b ≠ 0 ∧ 0 ≤ r ∧ ‖b‖ = s ∧ b * ↑r = w
BorceaVariance.normalize_counterexample (p : Polynomial ℂ) (hn : 2 ≤ p.natDegree) (a : ℂ) (ha : Polynomial.eval a p = 0)
  (hfar : ∀ (z : ℂ), Polynomial.eval z (Polynomial.derivative p) = 0 → BorceaVariance.sigma2 p < ‖a - z‖) :
  Nonempty (BorceaVariance.NormalizedCounterexample p.natDegree)
BorceaVariance.normalized_root_factorization {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n) :
  ∃ s,
    s.card = n - 1 ∧
      Cex.polynomial.roots = ↑Cex.distinguished ::ₘ s ∧
        Cex.polynomial =
            (Polynomial.X - Polynomial.C ↑Cex.distinguished) *
              (Multiset.map (fun z => Polynomial.X - Polynomial.C z) s).prod ∧
          ↑Cex.distinguished + s.sum = 0 ∧ Cex.distinguished ^ 2 + (Multiset.map (fun z => ‖z‖ ^ 2) s).sum = ↑n
BorceaVariance.phi_succ_mono {m : ℕ} (hm : 0 < m) {a : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ 1 + (1 - a ^ 2) / ↑m) :
  BorceaVariance.Phi m a ≤ BorceaVariance.Phi (m + 1) a
BorceaVariance.phi_base_nonneg_of_degree {m : ℕ} (hm : 0 < m) {a : ℝ} (hdom : a ^ 2 ≤ ↑m) : 0 ≤ 1 + (1 - a ^ 2) / ↑m
BorceaVariance.phi_mono_degree {m k : ℕ} (hm : 0 < m) (hmk : m ≤ k) {a : ℝ} (ha : 0 ≤ a) (hdom : a ^ 2 ≤ ↑m) :
  BorceaVariance.Phi m a ≤ BorceaVariance.Phi k a
BorceaVariance.hasDerivAt_phiSquareKernel {m : ℕ} (hm : 0 < m) (x : ℝ) :
  HasDerivAt (BorceaVariance.phiSquareKernel m) (2 * x * (↑m + 1) / ↑m * (1 - x ^ 2) * (1 + (1 - x ^ 2) / ↑m) ^ (m - 1))
    x
BorceaVariance.phi_mono_before_one {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ 1) :
  BorceaVariance.Phi m a ≤ BorceaVariance.Phi m b
BorceaVariance.phi_antitone_after_one {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 1 ≤ a) (hab : a ≤ b) (hb : b ^ 2 ≤ ↑m) :
  BorceaVariance.Phi m b ≤ BorceaVariance.Phi m a
BorceaVariance.eval_affinePullback (p : Polynomial ℂ) (b c z : ℂ) :
  Polynomial.eval z (BorceaVariance.affinePullback p b c) = Polynomial.eval (b * z + c) p
BorceaVariance.natDegree_affinePullback (p : Polynomial ℂ) {b : ℂ} (hb : b ≠ 0) (c : ℂ) :
  (BorceaVariance.affinePullback p b c).natDegree = p.natDegree
BorceaVariance.derivative_affinePullback (p : Polynomial ℂ) (b c : ℂ) :
  Polynomial.derivative (BorceaVariance.affinePullback p b c) =
    Polynomial.C b * BorceaVariance.affinePullback (Polynomial.derivative p) b c
BorceaVariance.roots_affinePullback (p : Polynomial ℂ) {b : ℂ} (hb : b ≠ 0) (c : ℂ) :
  (BorceaVariance.affinePullback p b c).roots = Multiset.map (fun z => (z - c) / b) p.roots
BorceaVariance.critical_roots_affinePullback (p : Polynomial ℂ) {b : ℂ} (hb : b ≠ 0) (c : ℂ) :
  (Polynomial.derivative (BorceaVariance.affinePullback p b c)).roots =
    Multiset.map (fun z => (z - c) / b) (Polynomial.derivative p).roots
BorceaVariance.roots_card (p : Polynomial ℂ) : p.roots.card = p.natDegree
BorceaVariance.multiset_sum_affine (s : Multiset ℂ) (b c : ℂ) :
  (Multiset.map (fun z => (z - c) / b) s).sum = (s.sum - ↑s.card * c) / b
BorceaVariance.centroid_affinePullback (p : Polynomial ℂ) (hn : 0 < p.natDegree) {b : ℂ} (hb : b ≠ 0) (c : ℂ) :
  BorceaVariance.centroid (BorceaVariance.affinePullback p b c) = (BorceaVariance.centroid p - c) / b
BorceaVariance.centroid_C_mul (p : Polynomial ℂ) {c : ℂ} (hc : c ≠ 0) :
  BorceaVariance.centroid (Polynomial.C c * p) = BorceaVariance.centroid p
BorceaVariance.variance_C_mul (p : Polynomial ℂ) {c : ℂ} (hc : c ≠ 0) :
  BorceaVariance.variance (Polynomial.C c * p) = BorceaVariance.variance p
BorceaVariance.sigma2_C_mul (p : Polynomial ℂ) {c : ℂ} (hc : c ≠ 0) :
  BorceaVariance.sigma2 (Polynomial.C c * p) = BorceaVariance.sigma2 p
BorceaVariance.variance_affinePullback (p : Polynomial ℂ) (hn : 0 < p.natDegree) {b : ℂ} (hb : b ≠ 0) (c : ℂ) :
  BorceaVariance.variance (BorceaVariance.affinePullback p b c) = BorceaVariance.variance p / ‖b‖ ^ 2
BorceaVariance.sigma2_affinePullback (p : Polynomial ℂ) (hn : 0 < p.natDegree) {b : ℂ} (hb : b ≠ 0) (c : ℂ) :
  BorceaVariance.sigma2 (BorceaVariance.affinePullback p b c) = BorceaVariance.sigma2 p / ‖b‖
BorceaVariance.actual_critical_family_centered {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) : ∑ j, ζ j = 0
BorceaVariance.actual_critical_family_far {n : ℕ} (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) (j : Fin (n - 1)) :
  1 < ‖↑Cex.distinguished - ζ j‖
BorceaVariance.normalized_reciprocal_moments {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n)
  (ζ : Fin (n - 1) → ℂ) (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  have a := Cex.distinguished;
  have q := BorceaVariance.reciprocalFamily a ζ;
  have μ := BorceaVariance.mean q;
  have s := BorceaVariance.secondMoment q;
  have v := BorceaVariance.centeredVariance q;
  have V := 1 - 1 / (↑n - 1);
  ‖μ‖ ^ 2 + (1 - V) * (1 - s) ≤ 2 * a * μ.re - a ^ 2 * s ∧
    ‖μ - ↑a‖ ^ 2 ≤ (a ^ 2 + V - 1) * (1 - s) ∧
      ‖1 - ↑a * μ‖ ^ 2 ≤ V * v ∧ 1 ≤ s * (a ^ 2 + V) ∧ BorceaVariance.beta a μ s 1 ≤ (a ^ 2 + V) * v
BorceaVariance.normalized_distinguished_pos {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n) :
  0 < Cex.distinguished
BorceaVariance.hasDerivAt_psi (a : ℝ) : HasDerivAt BorceaVariance.Psi (Real.exp ((1 - a ^ 2) / 2) * (1 - a ^ 2)) a
BorceaVariance.psi_mono_before_one {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ 1) :
  BorceaVariance.Psi a ≤ BorceaVariance.Psi b
BorceaVariance.psi_antitone_after_one {a b : ℝ} (ha : 1 ≤ a) (hab : a ≤ b) : BorceaVariance.Psi b ≤ BorceaVariance.Psi a
BorceaVariance.psi_two_lt : BorceaVariance.Psi 2 < 9 / 20
BorceaVariance.reciprocal_mul {m : ℕ} (a : ℝ) (ζ : Fin m → ℂ) (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) (j : Fin m) :
  (↑a - ζ j) * BorceaVariance.reciprocalFamily a ζ j = 1
BorceaVariance.reciprocal_norm_lt_one {m : ℕ} (a : ℝ) (ζ : Fin m → ℂ) (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖)
  (j : Fin m) : ‖BorceaVariance.reciprocalFamily a ζ j‖ < 1
BorceaVariance.reciprocal_ne_zero {m : ℕ} (a : ℝ) (ζ : Fin m → ℂ) (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) (j : Fin m) :
  BorceaVariance.reciprocalFamily a ζ j ≠ 0
BorceaVariance.reciprocal_conjugate_formula {m : ℕ} (a : ℝ) (ζ : Fin m → ℂ) (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0)
  (j : Fin m) :
  BorceaVariance.reciprocalFamily a ζ j = (↑a - (starRingEnd ℂ) (ζ j)) * ↑(‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2)
BorceaVariance.reciprocal_product_identity {m : ℕ} (a : ℝ) (ζ : Fin m → ℂ) (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0)
  (j : Fin m) : ζ j * BorceaVariance.reciprocalFamily a ζ j = ↑a * BorceaVariance.reciprocalFamily a ζ j - 1
BorceaVariance.sum_beta {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a t : ℝ) :
  ∑ j, ‖1 - ↑a * ↑t * q j‖ ^ 2 = ↑m * BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t
BorceaVariance.beta_decomposition {m : ℕ} (q : Fin m → ℂ) (a t : ℝ) :
  BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t =
    ‖1 - ↑a * ↑t * BorceaVariance.mean q‖ ^ 2 + a ^ 2 * t ^ 2 * BorceaVariance.centeredVariance q
BorceaVariance.beta_nonneg {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (a t : ℝ) :
  0 ≤ BorceaVariance.beta a (BorceaVariance.mean q) (BorceaVariance.secondMoment q) t
BorceaVariance.secondMoment_reciprocal_lt_one {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) : BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) < 1
BorceaVariance.secondMoment_reciprocal_pos {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) : 0 < BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)
BorceaVariance.centered_shift_energy {m : ℕ} (hm : 0 < m) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0) (a : ℝ) :
  ∑ j, ‖↑a - ζ j‖ ^ 2 = ↑m * (a ^ 2 + BorceaVariance.secondMoment ζ)
BorceaVariance.reciprocal_weight_sum {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) :
  ∑ j, (1 - ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2) =
    ↑m * (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ))
BorceaVariance.reciprocal_weighted_energy {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) :
  ∑ j, (1 - ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2) * ‖(starRingEnd ℂ) (ζ j)‖ ^ 2 =
    ↑m *
      (BorceaVariance.secondMoment ζ -
        BorceaVariance.beta a (BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ))
          (BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) 1)
BorceaVariance.reciprocal_weighted_identity {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) :
  ∑ j, ↑(1 - ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2) * (starRingEnd ℂ) (ζ j) =
    ↑m *
      (BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ) -
        ↑(a * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)))
BorceaVariance.reciprocal_centered_identity {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) :
  ∑ j, ζ j * (BorceaVariance.reciprocalFamily a ζ j - BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ)) =
    ↑m * (↑a * BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ) - 1)
BorceaVariance.norm_sub_real_sq (z : ℂ) (r : ℝ) : ‖z - ↑r‖ ^ 2 = ‖z‖ ^ 2 - 2 * r * z.re + r ^ 2
BorceaVariance.norm_one_sub_real_mul_sq (a : ℝ) (z : ℂ) : ‖1 - ↑a * z‖ ^ 2 = 1 - 2 * a * z.re + a ^ 2 * ‖z‖ ^ 2
BorceaVariance.reciprocal_weighted_cauchy {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) :
  ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ) -
          ↑(a * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ))‖ ^
      2 ≤
    (BorceaVariance.secondMoment ζ -
        BorceaVariance.beta a (BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ))
          (BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) 1) *
      (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ))
BorceaVariance.reciprocal_moment_A {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  2 * a * (BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ)).re -
      a ^ 2 * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) ≥
    ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ)‖ ^ 2 +
      (1 - V) * (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ))
BorceaVariance.reciprocal_moment_A_distance {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ) - ↑a‖ ^ 2 ≤
    (a ^ 2 + V - 1) * (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ))
BorceaVariance.reciprocal_moment_B {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  ‖1 - ↑a * BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ)‖ ^ 2 ≤
    V * BorceaVariance.centeredVariance (BorceaVariance.reciprocalFamily a ζ)
BorceaVariance.reciprocal_inverse_moment {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  1 ≤ BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) * (a ^ 2 + V)
BorceaVariance.reciprocal_moment_endpoint {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hne : ∀ (j : Fin m), ↑a - ζ j ≠ 0) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  BorceaVariance.beta a (BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ))
      (BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) 1 ≤
    (a ^ 2 + V) * BorceaVariance.centeredVariance (BorceaVariance.reciprocalFamily a ζ)
BorceaVariance.reciprocal_moments {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) {V : ℝ} (hV : BorceaVariance.secondMoment ζ ≤ V) :
  have q := BorceaVariance.reciprocalFamily a ζ;
  have μ := BorceaVariance.mean q;
  have s := BorceaVariance.secondMoment q;
  have v := BorceaVariance.centeredVariance q;
  ‖μ‖ ^ 2 + (1 - V) * (1 - s) ≤ 2 * a * μ.re - a ^ 2 * s ∧
    ‖μ - ↑a‖ ^ 2 ≤ (a ^ 2 + V - 1) * (1 - s) ∧
      ‖1 - ↑a * μ‖ ^ 2 ≤ V * v ∧ 1 ≤ s * (a ^ 2 + V) ∧ BorceaVariance.beta a μ s 1 ≤ (a ^ 2 + V) * v
BorceaVariance.normalized_degree_bound {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n) :
  Cex.distinguished ^ 2 ≤ ↑n - 1
BorceaVariance.schoenberg_centered_monic (p : Polynomial ℂ) (hp : p.Monic) (hn : 2 ≤ p.natDegree)
  (hcenter : p.roots.sum = 0) :
  (Multiset.map (fun z => ‖z‖ ^ 2) (Polynomial.derivative p).roots).sum ≤
    (↑p.natDegree - 2) / ↑p.natDegree * (Multiset.map (fun z => ‖z‖ ^ 2) p.roots).sum
BorceaVariance.schoenberg_centered (p : Polynomial ℂ) (hn : 2 ≤ p.natDegree) (hcenter : p.roots.sum = 0) :
  (Multiset.map (fun z => ‖z‖ ^ 2) (Polynomial.derivative p).roots).sum ≤
    (↑p.natDegree - 2) / ↑p.natDegree * (Multiset.map (fun z => ‖z‖ ^ 2) p.roots).sum
BorceaVariance.normalized_critical_energy_bound {n : ℕ} (hn : 2 ≤ n) (Cex : BorceaVariance.NormalizedCounterexample n) :
  (Multiset.map (fun z => ‖z‖ ^ 2) (Polynomial.derivative Cex.polynomial).roots).sum ≤ ↑n - 2
BorceaVariance.normalized_critical_secondMoment_bound {n : ℕ} (hn : 2 ≤ n)
  (Cex : BorceaVariance.NormalizedCounterexample n) (ζ : Fin (n - 1) → ℂ)
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) :
  BorceaVariance.secondMoment ζ ≤ 1 - 1 / (↑n - 1)
BorceaVariance.schoenberg_centered_monic_equality (p : Polynomial ℂ) (hp : p.Monic) (hn : 2 ≤ p.natDegree)
  (hcenter : p.roots.sum = 0) :
  (Multiset.map (fun z => ‖z‖ ^ 2) (Polynomial.derivative p).roots).sum =
      (↑p.natDegree - 2) / ↑p.natDegree * (Multiset.map (fun z => ‖z‖ ^ 2) p.roots).sum ↔
    Collinear ℝ {z | Polynomial.eval z p = 0}
BorceaVariance.schoenberg_centered_equality (p : Polynomial ℂ) (hn : 2 ≤ p.natDegree) (hcenter : p.roots.sum = 0) :
  (Multiset.map (fun z => ‖z‖ ^ 2) (Polynomial.derivative p).roots).sum =
      (↑p.natDegree - 2) / ↑p.natDegree * (Multiset.map (fun z => ‖z‖ ^ 2) p.roots).sum ↔
    Collinear ℝ {z | Polynomial.eval z p = 0}
BorceaVariance.sharpPolynomial_degree {n : ℕ} (hn : 0 < n) : (BorceaVariance.sharpPolynomial n).natDegree = n
BorceaVariance.sharpPolynomial_root_norm {n : ℕ} (hn : 0 < n) {z : ℂ}
  (hz : Polynomial.eval z (BorceaVariance.sharpPolynomial n) = 0) : ‖z‖ = 1
BorceaVariance.sharpPolynomial_centroid {n : ℕ} (hn : 2 ≤ n) :
  BorceaVariance.centroid (BorceaVariance.sharpPolynomial n) = 0
BorceaVariance.sharpPolynomial_sigma2 {n : ℕ} (hn : 2 ≤ n) :
  BorceaVariance.sigma2 (BorceaVariance.sharpPolynomial n) = 1
BorceaVariance.sharpPolynomial_critical_iff {n : ℕ} (hn : 2 ≤ n) (z : ℂ) :
  Polynomial.eval z (Polynomial.derivative (BorceaVariance.sharpPolynomial n)) = 0 ↔ z = 0
BorceaVariance.sharpness_family {n : ℕ} (hn : 2 ≤ n) :
  (BorceaVariance.sharpPolynomial n).natDegree = n ∧
    BorceaVariance.centroid (BorceaVariance.sharpPolynomial n) = 0 ∧
      BorceaVariance.sigma2 (BorceaVariance.sharpPolynomial n) = 1 ∧
        (∀ (z : ℂ), Polynomial.eval z (Polynomial.derivative (BorceaVariance.sharpPolynomial n)) = 0 ↔ z = 0) ∧
          ∀ (a : ℂ), Polynomial.eval a (BorceaVariance.sharpPolynomial n) = 0 → ‖a - 0‖ = 1
BorceaVariance.constant_one_sharp {c : ℝ} (hc : c < 1) :
  ∃ p,
    2 ≤ p.natDegree ∧
      Polynomial.eval 1 p = 0 ∧
        ∀ (z : ℂ), Polynomial.eval z (Polynomial.derivative p) = 0 → c * BorceaVariance.sigma2 p < ‖1 - z‖
BorceaVariance.iterated_derivative_leadingCoeff (p : Polynomial ℂ) (hp : p.Monic) {k : ℕ} (hk : k ≤ p.natDegree) :
  ((⇑Polynomial.derivative)^[p.natDegree - k] p).leadingCoeff = ↑(p.natDegree.descFactorial (p.natDegree - k))
BorceaVariance.iterated_derivative_root_product (p : Polynomial ℂ) (hp : p.Monic) {k : ℕ} (hk : k ≤ p.natDegree) :
  ‖p.roots.esymm k‖ = ↑(p.natDegree.choose k) * ‖((⇑Polynomial.derivative)^[p.natDegree - k] p).roots.prod‖
BorceaVariance.polynomial_root_energy_nonneg (p : Polynomial ℂ) : 0 ≤ (Multiset.map (fun z => ‖z‖ ^ 2) p.roots).sum
BorceaVariance.centered_polynomial_esymm_bound (p : Polynomial ℂ) (hp : p.Monic) (hcenter : p.roots.sum = 0) {k : ℕ}
  (hk : 2 ≤ k) (hkd : k ≤ p.natDegree) :
  ‖p.roots.esymm k‖ ≤
    ↑(p.natDegree.choose k) *
      ((↑k - 1) / (↑p.natDegree * (↑p.natDegree - 1)) * (Multiset.map (fun z => ‖z‖ ^ 2) p.roots).sum) ^ (↑k / 2)
BorceaVariance.centered_family_esymm_bound {m : ℕ} (w : Fin m → ℂ) (hcenter : ∑ j, w j = 0) {k : ℕ} (hk : 2 ≤ k)
  (hkm : k ≤ m) :
  ‖BorceaVariance.elementarySymmetric w k‖ ≤
    ↑(m.choose k) * ((↑k - 1) / (↑m - 1) * BorceaVariance.secondMoment w) ^ (↑k / 2)
BorceaVariance.centered_coefficients {m : ℕ} (q : Fin m → ℂ) {k : ℕ} (hk : 2 ≤ k) (hkm : k ≤ m) :
  ‖BorceaVariance.elementarySymmetric (fun j => q j - BorceaVariance.mean q) k‖ ≤
    ↑(m.choose k) * ((↑k - 1) / (↑m - 1) * BorceaVariance.centeredVariance q) ^ (↑k / 2)
BorceaVariance.centered_error_coefficient_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {a d t : ℝ} (ha : 0 ≤ a)
  (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) (ht : 0 ≤ t) (ht1 : t ≤ 1) :
  ‖BorceaVariance.centeredError q a t‖ ≤
    ∑ k ∈ Finset.Ico 2 (m + 1),
      a ^ k * ‖BorceaVariance.elementarySymmetric (fun j => q j - BorceaVariance.mean q) k‖ *
        (t ^ k * (1 - t + d * t) ^ (m - k))
BorceaVariance.centered_error_integral_coefficient_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {a d : ℝ} (ha : 0 ≤ a)
  (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) :
  ‖∫ (t : ℝ) in 0..1, BorceaVariance.centeredError q a t‖ ≤
    ∑ k ∈ Finset.Ico 2 (m + 1),
      a ^ k * ‖BorceaVariance.elementarySymmetric (fun j => q j - BorceaVariance.mean q) k‖ *
        BorceaVariance.integralPolynomial k (m - k) d
BorceaVariance.pow_mul_half_rpow {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (k : ℕ) :
  a ^ k * b ^ (↑k / 2) = (a ^ 2 * b) ^ (↑k / 2)
BorceaVariance.coefficient_error_integral_bound {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {a d : ℝ} (ha : 0 ≤ a)
  (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) :
  (↑m + 1) * ‖∫ (t : ℝ) in 0..1, BorceaVariance.centeredError q a t‖ ≤
    ∑ k ∈ Finset.Ico 2 (m + 1),
      (a ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑m - 1)) ^ (↑k / 2) *
        BorceaVariance.integralPowerSum k (m - k) d
BorceaVariance.tail_coefficient_bound {m : ℕ} (K : ℕ) (q : Fin m → ℂ) {a d t : ℝ} (ha : 0 ≤ a)
  (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) (ht : 0 ≤ t) (ht1 : t ≤ 1) :
  ‖BorceaVariance.centeredTail q a K t‖ ≤
    ∑ k ∈ Finset.Ico K (m + 1),
      a ^ k * ‖BorceaVariance.elementarySymmetric (fun j => q j - BorceaVariance.mean q) k‖ *
        (t ^ k * (1 - t + d * t) ^ (m - k))
BorceaVariance.tail_integral_coefficient_bound {m : ℕ} (K : ℕ) (q : Fin m → ℂ) {a d : ℝ} (ha : 0 ≤ a)
  (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) :
  ‖∫ (t : ℝ) in 0..1, BorceaVariance.centeredTail q a K t‖ ≤
    ∑ k ∈ Finset.Ico K (m + 1),
      a ^ k * ‖BorceaVariance.elementarySymmetric (fun j => q j - BorceaVariance.mean q) k‖ *
        BorceaVariance.integralPolynomial k (m - k) d
BorceaVariance.coefficient_tail_integral_bound {m : ℕ} (hm : 0 < m) {K : ℕ} (hK : 2 ≤ K) (q : Fin m → ℂ) {a d : ℝ}
  (ha : 0 ≤ a) (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) :
  (↑m + 1) * ‖∫ (t : ℝ) in 0..1, BorceaVariance.centeredTail q a K t‖ ≤
    ∑ k ∈ Finset.Ico K (m + 1),
      (a ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑m - 1)) ^ (↑k / 2) *
        BorceaVariance.integralPowerSum k (m - k) d
BorceaVariance.center_integral_norm_test {m : ℕ} (q : Fin m → ℂ) {a : ℝ} (ha : 0 ≤ a) (J : ℂ)
  (horigin : ↑(m + 1) * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t = (-1) ^ m * J) {Cbound d : ℝ}
  (hC : ‖↑a * BorceaVariance.mean q * J‖ ≤ Cbound) (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) :
  1 ≤
    Cbound + d ^ (m + 1) +
      (↑m + 1) * a * ‖BorceaVariance.mean q‖ * ‖∫ (t : ℝ) in 0..1, BorceaVariance.centeredError q a t‖
BorceaVariance.coefficient_integral_test {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) {a : ℝ} (ha : 0 ≤ a) (J : ℂ)
  (horigin : ↑(m + 1) * ∫ (t : ℝ) in 0..1, BorceaVariance.originProduct q a t = (-1) ^ m * J) {Cbound d : ℝ}
  (hC : ‖↑a * BorceaVariance.mean q * J‖ ≤ Cbound) (hd : ‖1 - ↑a * BorceaVariance.mean q‖ ≤ d) :
  1 ≤
    Cbound + d ^ (m + 1) +
      a * ‖BorceaVariance.mean q‖ *
        ∑ k ∈ Finset.Ico 2 (m + 1),
          (a ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑m - 1)) ^ (↑k / 2) *
            BorceaVariance.integralPowerSum k (m - k) d
BorceaVariance.normalized_coefficient_integral_test {n : ℕ} (hn : 2 ≤ n)
  (Cex : BorceaVariance.NormalizedCounterexample n) (z ζ : Fin (n - 1) → ℂ)
  (hz : Cex.polynomial = (Polynomial.X - Polynomial.C ↑Cex.distinguished) * ∏ j, (Polynomial.X - Polynomial.C (z j)))
  (hζ : ↑(List.ofFn ζ) = (Polynomial.derivative Cex.polynomial).roots) {Cbound d : ℝ}
  (hC :
    ‖↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ) *
          BorceaVariance.jointProduct z (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤
      Cbound)
  (hd : ‖1 - ↑Cex.distinguished * BorceaVariance.mean (BorceaVariance.reciprocalFamily Cex.distinguished ζ)‖ ≤ d) :
  have q := BorceaVariance.reciprocalFamily Cex.distinguished ζ;
  1 ≤
    Cbound + d ^ n +
      Cex.distinguished * ‖BorceaVariance.mean q‖ *
        ∑ k ∈ Finset.Ico 2 n,
          (Cex.distinguished ^ 2 * BorceaVariance.centeredVariance q * (↑k - 1) / (↑n - 2)) ^ (↑k / 2) *
            BorceaVariance.integralPowerSum k (n - 1 - k) d
BorceaVariance.convex_pair_sum_upper {ell a b x y : ℝ} {f : ℝ → ℝ} (hf : ConvexOn ℝ (Set.Icc 0 ell) f)
  (ha : a ∈ Set.Icc 0 ell) (hb : b ∈ Set.Icc 0 ell) (hax : a ≤ x) (hxb : x ≤ b) (hsum : x + y = a + b) :
  f x + f y ≤ f a + f b
BorceaVariance.convex_packing_exists {ell : ℝ} (hell : 0 < ell) {f : ℝ → ℝ} (hf : ConvexOn ℝ (Set.Icc 0 ell) f)
  (hf0 : f 0 = 0) (s : Multiset ℝ) (hs : ∀ x ∈ s, x ∈ Set.Icc 0 ell) :
  ∃ k, ∃ r ∈ Set.Icc 0 ell, s.sum = ↑k * ell + r ∧ (Multiset.map f s).sum ≤ ↑k * f ell + f r
BorceaVariance.convex_packing_zero {ell r : ℝ} (hell : 0 < ell) {f : ℝ → ℝ} (hf : ConvexOn ℝ (Set.Icc 0 ell) f)
  (hf0 : f 0 = 0) (hmono : MonotoneOn f (Set.Icc 0 ell)) (s : Multiset ℝ) (hs : ∀ x ∈ s, x ∈ Set.Icc 0 ell) (k : ℕ)
  (hr : r ∈ Set.Icc 0 ell) (hsum : s.sum ≤ ↑k * ell + r) : (Multiset.map f s).sum ≤ ↑k * f ell + f r
