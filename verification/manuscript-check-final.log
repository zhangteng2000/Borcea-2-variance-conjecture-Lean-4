BorceaVariance.rotated_centered_energy {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (hμ : BorceaVariance.mean q ≠ 0) :
  ∑ j, ‖BorceaVariance.rotateToMean q j - ↑‖BorceaVariance.mean q‖‖ ^ 2 = ↑m * BorceaVariance.centeredVariance q
BorceaVariance.rotated_quadratic_real {m : ℕ} (hm : 0 < m) (q : Fin m → ℂ) (hμ : BorceaVariance.mean q ≠ 0) :
  (BorceaVariance.elementarySymmetric (fun j => BorceaVariance.rotateToMean q j - ↑‖BorceaVariance.mean q‖) 2).re =
