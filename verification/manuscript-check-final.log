        (-(↑m *
              ‖BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ) -
                    ↑(a * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ))‖ ^
                2) /
          (2 * BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) * V))
BorceaVariance.reciprocal_product_amgm {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) :
  ∏ j, ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2 ≤
    BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) ^ m
BorceaVariance.tao_product {m : ℕ} (ξ : Fin m → ℂ) (hpos : ∀ (j : Fin m), 0 < ‖ξ j‖) (hle : ∀ (j : Fin m), ‖ξ j‖ ≤ 1) :
  (∏ j, ‖ξ j‖) * ∑ j, ‖(ξ j)⁻¹ - (starRingEnd ℂ) (ξ j)‖ ≤ 1 - ∏ j, ‖ξ j‖ ^ 2
BorceaVariance.finite_radial_mean_bound {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖)
  (hsmall : ↑m * (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) < 1) :
  ‖↑a - BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ)‖ ^ 2 ≤
    (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) ^ 2 /
      (1 - ↑m * (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)))
BorceaVariance.finite_radial_variance_bound {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖)
  (hsmall : ↑m * (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) < 1) :
  BorceaVariance.secondMoment ζ ≤
    1 +
        (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ)) /
          (1 - ↑m * (1 - BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ))) -
      a ^ 2
BorceaVariance.product_radial_sqrt_bound {m : ℕ} (hm : 0 < m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) :
  ↑m * ‖↑a - BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ)‖ ≤
    (√(∏ j, ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2))⁻¹ - √(∏ j, ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2)
BorceaVariance.reciprocal_packing {m : ℕ} (hm : 2 ≤ m) (a : ℝ) (ζ : Fin m → ℂ) (hcenter : ∑ j, ζ j = 0)
  (hfar : ∀ (j : Fin m), 1 < ‖↑a - ζ j‖) {s η L : ℝ} (hη : 0 < η) (hηs : η < s) (hs1 : s ≤ 1)
  (hs : BorceaVariance.secondMoment (BorceaVariance.reciprocalFamily a ζ) ≤ s) (hL : 0 < L)
  (hprod : L ≤ ∏ j, ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2) (hkernel : BorceaVariance.packingKernel m s η < L)
  (k : ℕ) (hlow : η ^ (k + 1) ≤ L) (hhigh : L ≤ η ^ k) :
  (∀ (j : Fin m), η < ‖BorceaVariance.reciprocalFamily a ζ j‖ ^ 2) ∧
    ↑m * ‖↑a - BorceaVariance.mean (BorceaVariance.reciprocalFamily a ζ)‖ ≤
        ↑k * (1 - η) / √η + (1 - L / η ^ k) / √(L / η ^ k) ∧
      BorceaVariance.secondMoment ζ ≤ (↑k / η + 1 / (L / η ^ k) + ↑m - ↑k - 1) / ↑m - a ^ 2
BorceaVariance.packing_power_interval_exists {m : ℕ} (hm : 2 ≤ m) {η s L : ℝ} (hη : 0 < η) (hηs : η < s) (hL1 : L ≤ 1)
  (hkernel : BorceaVariance.packingKernel m s η < L) : ∃ k < m, η ^ (k + 1) ≤ L ∧ L ≤ η ^ k
