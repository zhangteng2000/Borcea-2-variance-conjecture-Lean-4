theorem certificateBlock43_exclusion (n : ℕ)
    (hd : (DegreeBlock.mk 168 209).Contains n) :
    ∀ x, initialBox.Contains x → ¬ Admissible n x := by
  have hn : 2 ≤ n := by have h : 168 ≤ n := hd.1; omega
